---
/**
 * Home page. One job: someone arriving from an ad sees what we sell, picks
 * prewarmed or fresh, and trusts the team doing it, in one calm scroll.
 *
 * Order: the choice (hero), proof, how it works, video reviews, what is
 * included, the comparison, questions, and one closing choice. Each buying
 * moment offers prewarmed and fresh as equals. Prices come from pricing.json
 * and proof from proof.js, so nothing here is typed in twice.
 */
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import Handoff from '../components/Handoff.astro';
import Testimonials from '../components/Testimonials.astro';
import WhatsApp from '../components/WhatsApp.astro';
import BuyChoice from '../components/BuyChoice.astro';
import ProviderMark from '../components/ProviderMark.astro';
import { products } from '../data/products.js';
import { site, order, wa } from '../data/site.js';
import pricing from '../data/pricing.json';
import tools from '../data/tools.json';
import { operator, certifications } from '../data/proof.js';
import { totalReviews } from '../data/testimonials.js';

const P = pricing.products;
const money = (n) => (Number.isInteger(n) ? `$${n}` : `$${n.toFixed(2)}`);
const freshLow = Math.min(...P['google-fresh'].tiers.flatMap((t) => Object.values(t.perUnit)));

const card = (slug, from) => ({ ...products.find((p) => p.slug === slug), from });

/** Prewarmed and fresh as two equal lanes, Google and Azure in each. */
const lanes = [
  { key: 'prewarmed', tag: 'Prewarmed', h: 'Ready to send the day it arrives', cta: 'Get prewarmed inboxes', items: [
    card('prewarmed-google-inboxes', `From ${money(P['google-prewarmed'].perUnit.quarterly)} an inbox a month, domain included`),
    card('prewarmed-azure-inboxes', `From ${money(P['azure-tenant'].perTenant.quarterly)} a tenant of ${P['azure-tenant'].inboxesPerTenant} a month`),
  ]},
  { key: 'fresh', tag: 'Fresh', h: 'Cheaper long term, on your own domain', cta: 'Get fresh inboxes', items: [
    card('fresh-google-inboxes', `${money(P['google-fresh'].fromPrice)} down to ${money(freshLow)} an inbox a month`),
    card('fresh-azure-inboxes', `${money(P['azure-fresh'].perTenant.monthly)} a tenant a month, any billing cycle`),
  ]},
];

const steps = [
  ['Choose', 'Prewarmed or fresh, Google Workspace or Azure, and how many. All in one app.'],
  ['We build it', 'Domains, mailboxes, SPF, DKIM, DMARC and forwarding, on infrastructure isolated to you.'],
  ['Connect and send', 'Prewarmed sends on arrival. Fresh goes on your warmup tool for 14 to 21 days first.'],
];

const included = [
  ['Real accounts, your admin', 'Licensed Google Workspace and Azure mailboxes, not relays or shared seats.'],
  ['Isolated by design', 'Every domain in its own workspace, so nobody else’s sending touches yours.'],
  ['Authenticated on arrival', 'SPF, DKIM, DMARC and forwarding set and checked before you log in.'],
  ['Works with any sender', 'Instantly, Smartlead, Email Bison or an AI agent. Sending through an agent? We keep prewarmed inboxes warming in our own pool.'],
  ['Advisors on WhatsApp', 'Cold email operators answer 24/7, before you buy and after.'],
  ['Free tools and AI agent', `${tools.total} free deliverability tools, and an agent that runs them inside your own AI.`],
];

const faqs = [
  ['What is the difference between prewarmed and fresh?', 'Prewarmed inboxes arrive on a free domain that has already been aged 30 days and warmed 21, so they send the day they land. Fresh inboxes are built on your own branded domain, for up to half the price per inbox, and you warm them up on your own warmup tool (from about $97 a month) for 14 to 21 days first.'],
  ['How fast do I get them?', 'Prewarmed orders typically arrive the same day, and within 72 hours at the latest. Fresh orders arrive within 48 to 72 hours, then go on your warmup tool before they send.'],
  ['Who owns the accounts?', 'You do. They are licensed Google Workspace and Azure mailboxes with you as admin, so you can rotate passwords and revoke access yourself.'],
  ['How many emails a day can I send?', 'We suggest 15 per Google inbox with three inboxes on each domain, and 2 per mailbox on a full Azure tenant of 100. Cautious on purpose, and the setup that keeps working month after month.'],
  ['Which sending tools do they work with?', 'Any of them. Instantly, Smartlead, Email Bison, ManyReach and the rest all connect the same way.'],
  ['What if a domain stops landing in the inbox?', 'Retire it and start a new batch, which typically arrives the same day. Repairing a damaged domain takes weeks and rarely brings the reputation back.'],
  ['Who runs prewarmed.org?', site.disclosure],
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'FAQPage', mainEntity: faqs.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) },
  ],
};

const check = '<svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M7.7 13.6 4.4 10.3a.9.9 0 1 0-1.3 1.3l4 4a.9.9 0 0 0 1.3 0l8.5-8.5a.9.9 0 1 0-1.3-1.3z"/></svg>';
---
<Base
  title="Prewarmed & Fresh Cold Email Inboxes | prewarmed.org"
  description="Prewarmed Google and Azure inboxes on FREE domains, ready the day they arrive, or fresh inboxes on your own domain for up to 2X less."
  schema={schema}>

  <section class="hero">
    <div class="wrap hero-in">
      <p class="pill"><span class="dot" aria-hidden="true"></span>{operator.teamsServed} cold email teams send on this infrastructure</p>
      <h1>Cold Email Needs Warm Inboxes</h1>
      <p class="sub">Prewarmed Google and Azure inboxes on <strong>FREE domains</strong>, ready the day they arrive. Or start fresh on your own domain for up to 2X less.</p>
      <div class="hero-cta"><BuyChoice page="home" placement="hero" help={false} align="center" /></div>
      <p class="also">
        <a href={wa()} target="_blank" rel="noopener">Talk to an advisor on WhatsApp</a>
        <span aria-hidden="true">·</span>
        <a href="/deliverability-agent/">Get the free deliverability agent</a>
      </p>
      <Handoff />
      <p class="creds">{[`${totalReviews} named video reviews`, ...certifications.map((c) => c.label)].map((t) => t.replace(/ /g, '\u00a0')).join('  ·  ')}</p>
    </div>
  </section>

  <section class="proof">
    <div class="wrap proof-row">
      <div><b>{operator.monthlySends}</b><span>cold emails sent a month on this infrastructure</span></div>
      <div><b>{operator.replyRate}</b><span>reply rate across those campaigns</span></div>
      <div><b>{operator.teamsServed}</b><span>teams, including {operator.namedTeams.slice(0, 3).join(', ')}</span></div>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <h2 class="h">Prewarmed or fresh, on Google or Azure</h2>
      <div class="pf">
        {lanes.map((l) => (
          <div class={`lane lane-${l.key}`}>
            <p class="lane-tag">{l.tag}</p>
            <p class="lane-h">{l.h}</p>
            <div class="lane-cards">
              {l.items.map((p) => (
                <a class="pick" href={`/${p.slug}/`}>
                  <h3><ProviderMark provider={p.slug.includes('google') ? 'google' : 'azure'} />{p.eyebrow}</h3>
                  <p>{p.card}</p>
                  <p class="from">{p.from}</p>
                  <span class="more">View details →</span>
                </a>
              ))}
            </div>
            <a class="btn btn-primary lane-buy" href={order({ page: 'home', placement: `lane-${l.key}` })} target="_blank" rel="noopener">{l.cta}</a>
          </div>
        ))}
      </div>
      <div class="rec">
        <p><strong>Fresh is cheaper long term.</strong> New to cold email? We recommend starting with fresh inboxes on your own domain, and downloading the free deliverability agent to check your setup as you go.</p>
        <p class="rec-cta"><a class="btn btn-ghost" href="/deliverability-agent/">Download deliverability agent</a> <WhatsApp label="Help me choose" /></p>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <h2 class="h">How it works</h2>
      <ol class="steps">
        {steps.map(([h, b], i) => (
          <li><span class="n">{i + 1}</span><h3>{h}</h3><p>{b}</p></li>
        ))}
      </ol>
    </div>
  </section>

  <Testimonials page="home" limit={8} heading="Operators who send on it" />

  <section class="block">
    <div class="wrap">
      <h2 class="h">Included, whichever you choose</h2>
      <div class="inc">
        {included.map(([h, b]) => (
          <div class="inc-i"><span class="ck" set:html={check} /><div><h3>{h}</h3><p>{b}</p></div></div>
        ))}
      </div>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <h2 class="h">Prewarmed, fresh or do it yourself</h2>
      <div class="cmp">
        <table>
          <thead><tr><th></th><th>Prewarmed</th><th>Fresh</th><th>Do it yourself</th></tr></thead>
          <tbody>
            <tr><th scope="row">Ready to send</th><td class="yes" data-l="Prewarmed">On arrival</td><td data-l="Fresh">After 14 to 21 days</td><td data-l="Do it yourself">After about 51 days</td></tr>
            <tr><th scope="row">Domain</th><td class="yes" data-l="Prewarmed">FREE, already aged</td><td data-l="Fresh">Your own brand, or $12</td><td data-l="Do it yourself">You register it</td></tr>
            <tr><th scope="row">Mailbox price</th><td data-l="Prewarmed">Reseller rate</td><td class="yes" data-l="Fresh">Lowest per inbox</td><td data-l="Do it yourself">Retail list price</td></tr>
            <tr><th scope="row">Warmup tool</th><td class="yes" data-l="Prewarmed">Done before delivery</td><td data-l="Fresh">Yours, from ${P['warmup-tool'].price} a month</td><td data-l="Do it yourself">Yours, from ${P['warmup-tool'].price} a month</td></tr>
            <tr><th scope="row">SPF, DKIM, DMARC</th><td class="yes" data-l="Prewarmed">Set for you</td><td class="yes" data-l="Fresh">Set for you</td><td data-l="Do it yourself">You</td></tr>
          </tbody>
        </table>
      </div>
      <p class="cmp-more"><a href="/prewarmed-vs-fresh-inboxes/">Prewarmed vs fresh, in detail →</a> <a href="/calculator/">Price it for your volume →</a></p>
    </div>
  </section>

  <section class="block">
    <div class="wrap faq-wrap"><Faq faqs={faqs} heading="Questions" /></div>
  </section>

  <section class="final">
    <div class="wrap final-box">
      <h2>Prewarmed or fresh, we will have you sending.</h2>
      <p>Pick either in the app. Not sure which? Our advisors answer on WhatsApp, 24/7.</p>
      <div class="final-cta">
        <a class="btn btn-primary btn-lg" href={order({ page: 'home', placement: 'footer-cta-prewarmed' })} target="_blank" rel="noopener">Get prewarmed inboxes</a>
        <a class="btn btn-primary btn-lg" href={order({ page: 'home', placement: 'footer-cta-fresh' })} target="_blank" rel="noopener">Get fresh inboxes</a>
      </div>
      <div class="final-wa"><WhatsApp label="Talk to an advisor" /></div>
    </div>
  </section>
</Base>

<style>
  /* ---------- hero */
  .hero { padding: clamp(48px, 6.5vw, 92px) 0 clamp(48px, 6vw, 76px); }
  .hero-in { text-align: center; display: flex; flex-direction: column; align-items: center; }
  .pill { display: inline-flex; align-items: center; gap: 8px; margin: 0 0 24px; padding: 6px 12px; border: 1px solid var(--border); border-radius: 999px; font-size: 13.5px; color: var(--text-2); }
  .dot { flex: none; width: 7px; height: 7px; border-radius: 50%; background: var(--success); }
  .hero h1 { margin: 0 0 22px; font-size: clamp(42px, 5.4vw, 76px); line-height: 1.02; letter-spacing: -.04em; max-width: 11em; }
  .sub { margin: 0; font-size: clamp(17px, 1rem + .35vw, 20px); line-height: 1.55; color: var(--text-2); max-width: 36em; }
  .sub strong { color: var(--text); font-weight: 600; }
  .hero-cta { margin-top: 34px; }
  .also { margin: 22px 0 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 6px 10px; font-size: 15px; color: var(--text-muted); }
  .also a { color: var(--text); text-decoration: underline; text-decoration-color: var(--border-strong); text-underline-offset: 4px; }
  .also a:hover { color: var(--accent); text-decoration-color: var(--accent); }
  .hero-in :global(.handoff) { margin-top: 14px; font-size: 13px; }
  .creds { margin: 36px 0 0; padding-top: 22px; border-top: 1px solid var(--border); font-size: 13px; color: var(--text-muted); white-space: pre-wrap; max-width: 46em; }
  .ck { flex: none; color: var(--accent); display: inline-flex; margin-top: 2px; }

  /* ---------- prewarmed and fresh lanes */
  .pf { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  .lane { display: flex; flex-direction: column; border: 1px solid var(--border); border-radius: 18px; padding: 24px; background: var(--bg-elev); }
  .lane-tag { margin: 0 0 4px; font-size: 12px; letter-spacing: .09em; text-transform: uppercase; color: var(--accent); font-weight: 600; }
  .lane-h { margin: 0 0 18px; font-family: var(--font-display); font-weight: 600; font-size: 20px; letter-spacing: -.015em; color: var(--text); }
  .lane-cards { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; flex: 1; }
  .pick { display: flex; flex-direction: column; padding: 18px; border: 1px solid var(--border); border-radius: 14px; background: var(--bg); color: inherit; transition: border-color .15s; }
  .pick:hover { text-decoration: none; border-color: var(--accent); }
  .pick h3 { display: flex; align-items: flex-start; gap: 9px; margin: 0 0 8px; font-size: 16px; letter-spacing: -.01em; }
  .pick h3 :global(.pm) { margin-top: 2px; }
  .pick p { margin: 0; font-size: 14.5px; line-height: 1.5; color: var(--text-2); }
  .pick .from { margin-top: 12px; font-size: 13.5px; color: var(--text); font-weight: 500; }
  .more { margin-top: auto; padding-top: 14px; color: var(--accent); font-size: 14px; font-weight: 500; }
  .lane-buy { margin-top: 18px; width: 100%; min-height: 48px; }
  .rec { margin-top: 28px; border-left: 3px solid var(--accent); padding: 4px 0 4px 18px; }
  .rec p { margin: 0; max-width: 820px; font-size: 16.5px; line-height: 1.55; color: var(--text-2); }
  .rec strong { color: var(--text); }
  .rec-cta { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 16px !important; }

  /* ---------- proof */
  .proof { border-block: 1px solid var(--border); background: var(--bg-elev); }
  .proof-row { display: grid; grid-template-columns: repeat(3, 1fr); }
  .proof-row div { padding: 26px 24px; border-left: 1px solid var(--border); }
  .proof-row div:first-child { border-left: 0; padding-left: 0; }
  .proof-row b { display: block; font-family: var(--font-display); font-size: 30px; font-weight: 600; letter-spacing: -.03em; color: var(--text); }
  .proof-row span { display: block; margin-top: 4px; font-size: 14px; color: var(--text-muted); }

  /* ---------- sections */
  .block { padding: clamp(64px, 8vw, 104px) 0 0; }
  .h { margin: 0 0 32px; font-size: clamp(28px, 2.4vw, 38px); letter-spacing: -.03em; }
  .steps { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .steps li { padding: 24px; border: 1px solid var(--border); border-radius: 14px; }
  .n { display: inline-grid; place-items: center; width: 30px; height: 30px; border-radius: 50%; border: 1px solid var(--border-strong); font-size: 14px; font-weight: 600; color: var(--accent); }
  .steps h3, .inc h3 { margin: 16px 0 6px; font-size: 17px; letter-spacing: -.01em; }
  .steps p, .inc p { margin: 0; font-size: 15px; line-height: 1.55; color: var(--text-2); }
  .inc { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px 36px; }
  .inc-i { display: flex; align-items: flex-start; gap: 12px; }
  .inc-i .ck { margin-top: 3px; }
  .inc h3 { margin-top: 0; }
  .cmp { border: 1px solid var(--border); border-radius: 14px; overflow: hidden; }
  .cmp tbody tr:last-child > * { border-bottom: 0; }
  .cmp tbody th[scope='row'] { text-align: left; font-weight: 400; color: var(--text-2); text-transform: none; letter-spacing: normal; font-size: inherit; }
  .cmp-more { margin: 18px 0 0; display: flex; flex-wrap: wrap; gap: 8px 24px; font-size: 15px; }
  .faq-wrap { max-width: 860px; }

  /* ---------- close */
  .final { padding: clamp(72px, 9vw, 120px) 0; }
  .final-box { text-align: center; border: 1px solid var(--border); border-radius: 20px; padding: clamp(40px, 6vw, 64px) 24px; background: radial-gradient(120% 120% at 50% 0%, var(--accent-soft), transparent 60%), var(--bg-elev); }
  .final h2 { margin: 0 auto 12px; max-width: 18em; font-size: clamp(28px, 3vw, 40px); letter-spacing: -.03em; }
  .final-box > p { margin: 0 auto; color: var(--text-2); max-width: 36em; }
  .final-cta { display: flex; justify-content: center; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  .final-wa { display: flex; justify-content: center; margin-top: 12px; }

  @media (max-width: 980px) {
    .lane-cards { grid-template-columns: 1fr; }
  }
  @media (max-width: 860px) {
    .steps, .inc { grid-template-columns: 1fr; }
    .inc { gap: 22px; }
    .pf { grid-template-columns: 1fr; }
    .lane-cards { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 620px) {
    .proof-row { grid-template-columns: 1fr; }
    .proof-row div { border-left: 0; border-top: 1px solid var(--border); padding: 18px 0; }
    .proof-row div:first-child { border-top: 0; }
    .final-cta .btn, .final-wa :global(.wa) { width: 100%; }
    .hero-in { text-align: left; align-items: stretch; }
    .pill { align-self: flex-start; }
    .hero h1 { max-width: none; }
    .hero-cta { margin-top: 28px; }
    .also { flex-direction: column; align-items: flex-start; gap: 12px; }
    .also span { display: none; }
    .lane { padding: 16px; }
    .lane-cards { grid-template-columns: 1fr; }
    /* The comparison as one card per row on a phone: no sideways scroll. */
    .cmp table, .cmp tbody, .cmp tr, .cmp th, .cmp td { display: block; }
    .cmp thead { display: none; }
    .cmp tbody tr { padding: 14px 16px; border-bottom: 1px solid var(--border); }
    .cmp tbody tr:last-child { border-bottom: 0; }
    .cmp tbody th[scope='row'] { padding: 0 0 8px; border: 0; color: var(--text); font-weight: 600; }
    .cmp td { display: flex; justify-content: space-between; gap: 16px; padding: 5px 0; border: 0; font-size: 14.5px; }
    .cmp td::before { content: attr(data-l); color: var(--text-muted); }
    .cmp td { text-align: right; }
  }
</style>

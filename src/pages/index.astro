---
/**
 * The front page, whichever one is currently showing.
 *
 * site.alphaMode swaps the Alpha Foundation disclosure in for the home page
 * at /. The home page itself is not edited, moved or deleted: it sits in
 * _home.astro, which Astro does not route because of the underscore, and
 * comes straight back when the flag goes false. Every other page on the site
 * is untouched either way.
 */
import { site } from '../data/site.js';
import Home from './_home.astro';
import AlphaFoundation from '../components/AlphaFoundation.astro';
---
{site.alphaMode ? <AlphaFoundation /> : <Home />}

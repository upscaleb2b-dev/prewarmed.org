---
import Simple from '../layouts/Simple.astro';
import { site } from '../data/site.js';
import WhatsApp from '../components/WhatsApp.astro';
---
<Simple schema={{ '@type': 'ContactPage', name: 'Contact prewarmed.org', url: 'https://prewarmed.org/contact/' }} title="Contact. Prewarmed.org" description="Talk to someone who runs this infrastructure daily about domains, inboxes and sending setup. Replies within one business day."
  eyebrow="Contact" h1="Talk to an operator"
  lede="Tell us the volume you need and what broke last time. Replies within one business day.">
  <div class="fastlane">
    <div>
      <p class="fl-h">Want an answer now?</p>
      <p class="fl-p">WhatsApp reaches the operators running this infrastructure, 24/7. It is faster than the form and you can send screenshots.</p>
    </div>
    <WhatsApp variant="primary" label="Message us on WhatsApp" message="Hi, I have a question about prewarmed inboxes:" />
  </div>

  <p class="or"><span>or send the details</span></p>

  <form class="f" method="POST" action={site.leadEndpoint || "/contact/"} name="lead"
        data-endpoint={site.leadEndpoint} data-to={site.correctionsEmail}
        data-source={site.leadSource} data-xevent={site.analytics.xLeadEvent}>
    <input type="text" name="company_website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
    <div class="row">
      <label>Name<input name="name" required autocomplete="name" /></label>
      <label>Work email<input name="email" type="email" required autocomplete="email" /></label>
    </div>
    <div class="row">
      <label>Provider needed
        <select name="provider"><option>Not sure</option><option>Google Workspace</option><option>Microsoft 365</option><option>Azure / Entra tenant</option><option>Domains only</option></select>
      </label>
      <label>Inboxes<input name="inboxes" type="number" min="1" placeholder="30" /></label>
    </div>
    <label>Sequencer<input name="sequencer" placeholder="Smartlead, Instantly, Email Bison…" /></label>
    <label>What are you trying to do?<textarea name="message" rows="4" placeholder="Volume target, timeline, and what went wrong last time."></textarea></label>
    <button class="btn btn-primary btn-lg" type="submit">Send</button>
    <p class="senderr" id="senderr" role="alert" hidden></p>
    <p class="micro muted">No newsletter, no sequence. One reply from a person.</p>
  </form>
  <div class="fallback" id="fallback" hidden>
    <p><strong>Nothing has been sent yet.</strong> This form has no inbox behind it right now, so it cannot deliver your message on its own. Your details are below. Send them to <a href={`mailto:${site.correctionsEmail}`}>{site.correctionsEmail}</a> and you will get the same reply.</p>
    <textarea id="fbtext" rows="8" readonly></textarea>
    <div class="fbrow">
      <button class="btn btn-primary" type="button" id="fbcopy">Copy message</button>
      <a class="btn btn-ghost" id="fbmail" href="#">Open in your email app</a>
    </div>
  </div>

  <noscript>
    <p class="alt"><strong>This form needs JavaScript.</strong> Email <a href={`mailto:${site.correctionsEmail}`}>{site.correctionsEmail}</a> with the volume you need and what broke last time.</p>
  </noscript>

  <p class="alt">Would rather just email? <a href={`mailto:${site.correctionsEmail}`}>{site.correctionsEmail}</a>.</p>
</Simple>

<script is:inline>
  (() => {
    const form = document.querySelector('form.f');
    if (!form) return;
    const btn = form.querySelector('button[type=submit]');
    form.addEventListener('submit', async (e) => {
      if (form.company_website.value) return e.preventDefault();   // honeypot
      const endpoint = form.dataset.endpoint;
      e.preventDefault();
      const data = Object.fromEntries(new FormData(form).entries());
      delete data.company_website;
      btn.disabled = true; btn.textContent = 'Sending…';

      const done = () => {
        // One conversion per platform. The pixels are consent-gated, so each
        // is checked rather than assumed: outside the UK and EEA all three
        // exist, inside they exist only if the visitor accepted.
        window.dataLayer && window.dataLayer.push({ event: 'lead_submit' });
        if (window.gtag) window.gtag('event', 'generate_lead');
        if (window.fbq) window.fbq('track', 'Lead');
        if (window.twq && form.dataset.xevent) window.twq('event', form.dataset.xevent, {});
        location.href = '/thanks/';
      };

      if (endpoint) {
        // The endpoint takes a fixed shape, so the form's own fields are
        // folded into one enquiry string rather than posted raw, anything it
        // does not recognise would be dropped, and the volume, timeline and
        // what-broke-last-time answer is the entire value of the lead.
        const name = (data.name || '').trim();
        const sp = name.indexOf(' ');
        const enquiry = [
          data.provider && `Provider: ${data.provider}`,
          data.inboxes && `Inboxes: ${data.inboxes}`,
          data.sequencer && `Sequencer: ${data.sequencer}`,
          data.message && `\n${data.message}`,
        ].filter(Boolean).join('\n');

        try {
          const r = await fetch(endpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              email: (data.email || '').trim(),
              source: form.dataset.source,
              firstName: sp > 0 ? name.slice(0, sp) : name || undefined,
              lastName: sp > 0 ? name.slice(sp + 1) : undefined,
              enquiry: enquiry || undefined,
            }),
          });
          if (r.ok) return done();
          // 4xx messages are written for a visitor to read; 5xx are not.
          const j = await r.json().catch(() => ({}));
          throw new Error(r.status < 500 && j.error ? j.error : '');
        } catch (err) {
          btn.disabled = false; btn.textContent = 'Send';
          const why = err && err.message;
          document.getElementById('senderr').textContent = why
            ? why
            : 'That did not send. Your message is below. Send it to ' + form.dataset.to + ' and we will pick it up.';
          document.getElementById('senderr').hidden = false;
          if (!why) showFallback(data);
          return;
        }
      }
      // No endpoint configured at all. Never redirect to /thanks/, which
      // promises a reply, show the visitor their message instead.
      showFallback(data);
      btn.disabled = false; btn.textContent = 'Send';
    });

    // Shown when there is no endpoint, or when one fails in a way the visitor
    // cannot act on. Puts the message in front of them rather than losing it.
    function showFallback(data) {
      const body = Object.entries(data).map(([k, v]) => `${k}: ${v}`).join('\n');
      const subject = 'Inbox enquiry: ' + (data.name || '');
      const panel = document.getElementById('fallback');
      panel.querySelector('#fbtext').value = body;
      panel.querySelector('#fbmail').href =
        `mailto:${form.dataset.to}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      panel.hidden = false;
      panel.scrollIntoView({ behavior: 'smooth', block: 'center' });
      const copy = panel.querySelector('#fbcopy');
      copy.onclick = async () => {
        try { await navigator.clipboard.writeText(body); } catch { panel.querySelector('#fbtext').select(); document.execCommand('copy'); }
        copy.textContent = 'Copied';
        setTimeout(() => { copy.textContent = 'Copy message'; }, 2000);
      };
    }
  })();
</script>
<style>
  .fastlane { max-width: 620px; display: flex; flex-wrap: wrap; align-items: center; gap: 18px; justify-content: space-between;
    padding: 20px 22px; margin-bottom: 26px; border: 1px solid color-mix(in srgb, var(--accent) 30%, transparent);
    border-radius: var(--r-card); background: var(--accent-soft); }
  .fl-h { margin: 0 0 6px; font-size: 17px; font-weight: 600; color: var(--text); }
  .fl-p { margin: 0; font-size: 14.5px; color: var(--text-2); max-width: 44ch; line-height: 1.5; }
  .or { max-width: 620px; margin: 0 0 22px; text-align: center; position: relative; font-size: 13px;
    letter-spacing: .06em; text-transform: uppercase; color: var(--text-muted); }
  .or::before { content: ''; position: absolute; left: 0; right: 0; top: 50%; border-top: 1px solid var(--border); }
  .or span { position: relative; background: var(--bg); padding: 0 14px; }
  .f { display: grid; gap: 18px; max-width: 620px; }
  .row { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
  @media (max-width: 560px) { .row { grid-template-columns: 1fr; } }
  label { display: block; font-size: 13px; letter-spacing: .04em; text-transform: uppercase; color: var(--text-muted); font-weight: 500; }
  input, select, textarea { width: 100%; margin-top: 7px; font: inherit; font-size: 16px; text-transform: none; letter-spacing: normal; background: var(--bg-elev); color: var(--text); border: 1px solid var(--border-strong); border-radius: 6px; padding: 11px 13px; }
  textarea { resize: vertical; }
  .hp { position: absolute; left: -9999px; }
  .micro { font-size: 13px; margin: 0; }
  .senderr { margin: 0; font-size: 14.5px; color: #f85149; max-width: 62ch; line-height: 1.5; }
  .alt { font-size: 15px; color: var(--text-2); margin-top: 26px; }
  button { justify-self: start; }
  .fallback { max-width: 620px; margin-top: 26px; padding: 20px; border: 1px solid var(--border-strong); border-radius: 10px; background: var(--bg-elev); }
  .fallback p { margin: 0 0 14px; font-size: 15px; color: var(--text-2); }
  .fallback textarea { width: 100%; font-family: var(--font-mono, monospace); font-size: 13px; background: var(--bg); color: var(--text); border: 1px solid var(--border-strong); border-radius: 6px; padding: 11px 13px; resize: vertical; }
  .fbrow { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 14px; }
  .fbrow .btn { min-height: 44px; display: inline-flex; align-items: center; }
</style>

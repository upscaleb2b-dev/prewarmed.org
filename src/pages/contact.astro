---
import Simple from '../layouts/Simple.astro';
import { site } from '../data/site.js';
---
<Simple schema={{ '@type': 'ContactPage', name: 'Contact prewarmed.org', url: 'https://prewarmed.org/contact/' }} title="Contact — prewarmed.org" description="Talk to someone who runs this infrastructure daily about domains, inboxes and sending setup. Replies within one business day."
  eyebrow="Contact" h1="Talk to an operator"
  lede="Tell us the volume you need and what broke last time. Replies within one business day.">
  <form class="f" method="POST" action={site.leadEndpoint || "/contact/"} name="lead" data-endpoint={site.leadEndpoint} data-to={site.correctionsEmail}>
    <input type="text" name="company_website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
    <div class="row">
      <label>Name<input name="name" required autocomplete="name" /></label>
      <label>Work email<input name="email" type="email" required autocomplete="email" /></label>
    </div>
    <div class="row">
      <label>Provider needed
        <select name="provider"><option>Not sure</option><option>Google Workspace</option><option>Microsoft 365</option><option>Azure / Entra tenant</option><option>Domains only</option></select>
      </label>
      <label>Inboxes<input name="inboxes" type="number" min="1" placeholder="30" /></label>
    </div>
    <label>Sequencer<input name="sequencer" placeholder="Smartlead, Instantly, Email Bison…" /></label>
    <label>What are you trying to do?<textarea name="message" rows="4" placeholder="Volume target, timeline, and what went wrong last time."></textarea></label>
    <button class="btn btn-primary btn-lg" type="submit">Send</button>
    <p class="micro muted">No newsletter, no sequence. One reply from a person.</p>
  </form>
  <div class="fallback" id="fallback" hidden>
    <p><strong>Nothing has been sent yet.</strong> This form has no inbox behind it right now, so it cannot deliver your message on its own. Your details are below — send them to <a href={`mailto:${site.correctionsEmail}`}>{site.correctionsEmail}</a> and you will get the same reply.</p>
    <textarea id="fbtext" rows="8" readonly></textarea>
    <div class="fbrow">
      <button class="btn btn-primary" type="button" id="fbcopy">Copy message</button>
      <a class="btn btn-ghost" id="fbmail" href="#">Open in your email app</a>
    </div>
  </div>

  <noscript>
    <p class="alt"><strong>This form needs JavaScript.</strong> Email <a href={`mailto:${site.correctionsEmail}`}>{site.correctionsEmail}</a> with the volume you need and what broke last time.</p>
  </noscript>

  <p class="alt">Would rather just email? <a href={`mailto:${site.correctionsEmail}`}>{site.correctionsEmail}</a>.</p>
</Simple>

<script is:inline>
  (() => {
    const form = document.querySelector('form.f');
    if (!form) return;
    const btn = form.querySelector('button[type=submit]');
    form.addEventListener('submit', async (e) => {
      if (form.company_website.value) return e.preventDefault();   // honeypot
      const endpoint = form.dataset.endpoint;
      e.preventDefault();
      const data = Object.fromEntries(new FormData(form).entries());
      delete data.company_website;
      btn.disabled = true; btn.textContent = 'Sending…';
      const done = () => { window.dataLayer && window.dataLayer.push({ event: 'lead_submit' }); location.href = '/thanks/'; };
      if (endpoint) {
        try {
          const r = await fetch(endpoint, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) });
          if (!r.ok) throw new Error(r.status);
          return done();
        } catch {
          btn.disabled = false; btn.textContent = 'Send';
          alert('That did not send. Email ' + form.dataset.to + ' and we will pick it up.');
          return;
        }
      }
      // No backend configured. A mailto: opens nothing in most desktop Chrome
      // and much of mobile web, so redirecting to /thanks/ — which promises a
      // reply — would tell people their message was sent when it was not.
      // Show them what to send instead, and never claim delivery we cannot do.
      const body = Object.entries(data).map(([k, v]) => `${k}: ${v}`).join('\n');
      const subject = 'Inbox enquiry — ' + (data.name || '');
      const panel = document.getElementById('fallback');
      panel.querySelector('#fbtext').value = body;
      panel.querySelector('#fbmail').href =
        `mailto:${form.dataset.to}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      panel.hidden = false;
      btn.disabled = false; btn.textContent = 'Send';
      panel.scrollIntoView({ behavior: 'smooth', block: 'center' });
      const copy = panel.querySelector('#fbcopy');
      copy.onclick = async () => {
        try { await navigator.clipboard.writeText(body); } catch { panel.querySelector('#fbtext').select(); document.execCommand('copy'); }
        copy.textContent = 'Copied';
        setTimeout(() => { copy.textContent = 'Copy message'; }, 2000);
      };
    });
  })();
</script>
<style>
  .f { display: grid; gap: 18px; max-width: 620px; }
  .row { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
  @media (max-width: 560px) { .row { grid-template-columns: 1fr; } }
  label { display: block; font-size: 13px; letter-spacing: .04em; text-transform: uppercase; color: var(--text-muted); font-weight: 500; }
  input, select, textarea { width: 100%; margin-top: 7px; font: inherit; font-size: 16px; text-transform: none; letter-spacing: normal; background: var(--bg-elev); color: var(--text); border: 1px solid var(--border-strong); border-radius: 6px; padding: 11px 13px; }
  textarea { resize: vertical; }
  .hp { position: absolute; left: -9999px; }
  .micro { font-size: 13px; margin: 0; }
  .alt { font-size: 15px; color: var(--text-2); margin-top: 26px; }
  button { justify-self: start; }
  .fallback { max-width: 620px; margin-top: 26px; padding: 20px; border: 1px solid var(--border-strong); border-radius: 10px; background: var(--bg-elev); }
  .fallback p { margin: 0 0 14px; font-size: 15px; color: var(--text-2); }
  .fallback textarea { width: 100%; font-family: var(--font-mono, monospace); font-size: 13px; background: var(--bg); color: var(--text); border: 1px solid var(--border-strong); border-radius: 6px; padding: 11px 13px; resize: vertical; }
  .fbrow { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 14px; }
  .fbrow .btn { min-height: 44px; display: inline-flex; align-items: center; }
</style>

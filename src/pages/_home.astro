---
import Base from '../layouts/Base.astro';
import ToolCallout from '../components/ToolCallout.astro';
import CostCalc from '../components/CostCalc.astro';
import Faq from '../components/Faq.astro';
import { products } from '../data/products.js';
import { site, wi } from '../data/site.js';
import pricing from '../data/pricing.json';
import tools from '../data/tools.json';
import Handoff from '../components/Handoff.astro';
import ProviderMark from '../components/ProviderMark.astro';
import ProofStats from '../components/ProofStats.astro';
import Testimonials from '../components/Testimonials.astro';
import WhatsApp from '../components/WhatsApp.astro';

const liveTools = tools.tools.filter((t) => t.live).length;
const faqs = [
  ['What does prewarmed actually mean?', 'Thirty days of aging with the records in place, then twenty-one days of real sending and receiving. A lot of what is sold as prewarmed skips one half, or both.'],
  ['Are these real Google and Microsoft accounts?', 'Yes. Proper paid accounts on a domain we age and warm. Not a relay service, and not a seat on somebody else\'s account.'],
  ['How fast do I get them?', 'The same day, on business days. The 51 days of waiting already happened before you ordered.'],
  ['How many emails a day can I send?', 'We suggest 15 per inbox per day, with three inboxes on each domain. That is deliberately cautious, and it is the setup that keeps working month after month.'],
  ['What if a domain stops landing in the inbox?', 'Ask for the replacement terms in writing before you order, from anyone. Getting a damaged domain back is slow and often does not work, so how fast they replace it is what matters.'],
  ['Which sending tools do these work with?', 'Any of them. Smartlead, Instantly, Email Bison, ManyReach and the rest all connect the same way.'],
  ['Who runs prewarmed.org?', site.disclosure],
];
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'FAQPage', mainEntity: faqs.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) },
  ],
};
---
<Base
  title="Prewarmed Inboxes & Domains for Cold Email | prewarmed.org"
  description="Prewarmed inboxes on Google Workspace, Microsoft 365 or Azure, on a domain aged 30 days and warmed 21 more. DNS configured, delivered same day."
  schema={schema}>

  <section class="hero section">
    <div class="wrap">
      <p class="eyebrow">Prewarmed inboxes and domains for cold email</p>
      <h1>51 days of reputation.<br />Yours today.</h1>
      <p class="lede">Gmail and Outlook do not trust a new domain. We age and warm it 51 days so you can send today on Google Workspace, Microsoft 365 or Azure.</p>
      <div class="cta">
        <a class="btn btn-primary btn-lg" href={wi('/', { page: 'home', placement: 'hero' })} target="_blank" rel="noopener">Get inboxes</a>
        <a class="btn btn-ghost btn-lg" href="/tools/">{liveTools} free tools</a> <WhatsApp />
      </div>
      <Handoff />

      <div class="tl" role="img" aria-label="The 2026 Prewarmed Standard: 30 days aging, then 21 days warming, handover at day 51">
        <p class="tl-title">The 2026 Prewarmed Standard for Maximum Deliverability</p>
        <div class="tl-bar"><div class="seg age"><span>Aging · 30 days</span></div><div class="seg warm"><span>Warming · 21 days</span></div></div>
        <div class="tl-marks mono"><i class="s">day 0 · registered</i><i class="m">day 30 · first send</i><i class="e">day 51 · yours</i></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>What prewarmed means here</h2>
      <div class="grid g4" style="margin-top:26px">
        <div class="card"><h3>Proper accounts</h3><p class="muted">Real Google and Microsoft accounts, not a relay service or a shared seat.</p></div>
        <div class="card"><h3>30 days of age</h3><p class="muted">A domain’s age cannot be faked or rushed, and Gmail and Outlook both check it.</p></div>
        <div class="card"><h3>21 days of warming</h3><p class="muted">Three weeks of real emails sent and replied to, so the domain has a track record.</p></div>
        <div class="card"><h3>Skip the 21-day warmup wait</h3><p class="muted">The aging and warming already happened on our clock. You get the logins within hours and send today.</p></div>
      </div>
      <div class="means-cta">
        <a class="btn btn-primary btn-lg" href={wi('/', { page: 'home', placement: 'what-prewarmed-means' })} target="_blank" rel="noopener">Get prewarmed inboxes</a> <WhatsApp />
        <Handoff />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>Pick your provider</h2>
      <div class="grid g3" style="margin-top:28px">
        {products.filter((p) => ['prewarmed-google-inboxes','prewarmed-microsoft-365-inboxes','prewarmed-azure-inboxes'].includes(p.slug)).map((p) => (
          <a class="card pick" href={`/${p.slug}/`}>
            <h3><ProviderMark provider={p.slug.includes('google') ? 'google' : p.slug.includes('azure') ? 'azure' : 'microsoft'} />{p.eyebrow}</h3>
            <p class="muted">{p.card ?? p.description}</p>
            <span class="more">View →</span>
          </a>
        ))}
      </div>
      <div class="fresh-strip">
        <p><strong>Not starting for two months?</strong> Each one has a fresh version: cheaper, and you run the 51 days.</p>
        <p class="fresh-links">
          <a href="/fresh-google-inboxes/">Fresh Google</a>
          <a href="/fresh-microsoft-365-inboxes/">Fresh Microsoft 365</a>
          <a href="/fresh-azure-inboxes/">Fresh Azure tenants</a>
          <a href="/fresh-domains/">Fresh domains</a>
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>Prewarmed, fresh or do it yourself</h2>
      <div class="scroll-x" style="margin-top:24px">
        <table>
          <thead><tr><th></th><th>Prewarmed</th><th>Fresh inbox</th><th>Do it yourself</th></tr></thead>
          <tbody>
            <tr><th scope="row">How soon you can send</th><td class="yes">Same day</td><td>21 days on a domain you already use, 51 on a new one</td><td>51 days</td></tr>
            <tr><th scope="row">Domain age on day one</th><td class="yes">30 days +</td><td>Whatever yours already is</td><td>0 days</td></tr>
            <tr><th scope="row">What you pay for the mailbox</th><td class="yes">Reseller rate</td><td class="yes">Reseller rate</td><td class="no">Retail list price (${pricing.products['retail-list'].price.toFixed(2)})</td></tr>
            <tr><th scope="row">Cost of a warmup tool</th><td class="yes">None</td><td class="no">From ${pricing.products['warmup-tool'].price} a month</td><td class="no">From ${pricing.products['warmup-tool'].price} a month</td></tr>
            <tr><th scope="row">Domain included</th><td class="yes">Free</td><td class="no">No, ${pricing.products['domain-fresh'].price} a year</td><td class="no">No, ${pricing.products['domain-fresh'].price} a year</td></tr>
            <tr><th scope="row">SPF, DKIM and DMARC set up</th><td class="yes">Before handover</td><td class="yes">Before handover</td><td class="no">You</td></tr>
          </tbody>
        </table>
      </div>
      <p class="tnote"><strong>Doing it yourself is not cheaper.</strong> We buy at reseller rates, so a prewarmed inbox costs about what a provider charges you for the licence alone.</p>
    </div>
  </section>

  <ProofStats page="home" />

  <CostCalc />

  <section class="section">
    <div class="wrap">
      <ToolCallout id="deliverability-checker" page="home"
        headline="Not sure your current domain is the problem?"
        body="If replies stopped overnight, grade the domain you are sending from before you buy more inboxes. A to F across authentication, records and age. Free, no signup." />
    </div>
  </section>

  <section class="section">
    <div class="wrap"><Faq faqs={faqs} heading="Questions" /></div>
  </section>

  <Testimonials page="home" limit={6} />

  <section class="section final">
    <div class="wrap">
      <h2>Your next campaign can start today.</h2>
      <a class="btn btn-primary btn-lg cta-gap" href={wi('/', { page: 'home', placement: 'footer-cta' })} target="_blank" rel="noopener">Get inboxes</a> <WhatsApp />
      <Handoff align="center" />
    </div>
  </section>
</Base>

<style>
  .means-cta { margin-top: 30px; }
  /* Row headers for the comparison table: semantics without the column-head look. */
  tbody th[scope="row"] { text-align: left; font-weight: 400; color: var(--text-2); text-transform: none; letter-spacing: normal; font-size: inherit; }
  /* flex-start, not center: the Microsoft title wraps to two lines and the
     mark should sit against the first one. */
  .pick h3 { display: flex; align-items: flex-start; gap: 9px; }
  .pick h3 :global(.pm) { margin-top: 2px; }
  .hero { padding-block: clamp(48px, 7vw, 84px) clamp(40px, 5vw, 64px); }
  .hero h1 { margin: 14px 0 22px; }
  .cta { display: flex; gap: 12px; flex-wrap: wrap; margin: 30px 0 0; }
  .tl { margin-top: 46px; max-width: 860px; }
  .tl-title { margin: 0 0 14px; font-size: 12.5px; letter-spacing: .09em; text-transform: uppercase; color: var(--accent); font-weight: 600; }
  .tl-bar { display: flex; height: 52px; border: 1px solid var(--border-strong); border-radius: var(--r-btn); overflow: hidden; }
  .seg { display: flex; align-items: center; justify-content: center; font-family: var(--font-display); font-weight: 600; font-size: 14px; min-width: 0; }
  .seg span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; padding-inline: 12px; }
  .seg.age { flex: 30; background: var(--bg-elev-2); color: var(--text-2); }
  .seg.warm { flex: 21; background: var(--accent-soft); color: var(--text); border-left: 1px solid var(--border-strong); }
  .tl-marks { position: relative; height: 16px; margin-top: 10px; font-size: 11.5px; color: var(--text-muted); }
  .tl-marks i { position: absolute; top: 0; white-space: nowrap; font-style: normal; }
  .tl-marks .s { left: 0; } .tl-marks .m { left: 58.8%; transform: translateX(-50%); } .tl-marks .e { right: 0; }
  @media (max-width: 720px) { .tl-marks { display: none; } .tl-bar { height: auto; flex-direction: column; } .seg { padding-block: 12px; } .seg.warm { border-left: none; border-top: 1px solid var(--border-strong); } }
  .card h3 { font-size: 17px; margin-bottom: 8px; }
  .card p { font-size: 15px; margin: 0; }
  .pick { display: block; }
  .pick:hover { text-decoration: none; border-color: var(--accent); }
  .more { display: inline-block; margin-top: 14px; color: var(--accent); font-size: 14.5px; font-weight: 500; }
  .cta-gap { margin-top: 30px; }
  .fresh-strip { margin-top: 26px; border-left: 3px solid var(--accent); padding: 4px 0 4px 18px; }
  .fresh-strip p { color: var(--text-2); font-size: 16px; margin: 0; max-width: 760px; }
  .fresh-strip strong { color: var(--text); }
  .fresh-links { margin-top: 12px !important; display: flex; flex-wrap: wrap; gap: 8px 22px; }
  .fresh-links a { font-size: 15px; font-weight: 500; }
  @media (max-width: 860px) { .fresh-links { gap: 2px 20px; } .fresh-links a { display: block; padding: 11px 0; } }
  .tnote { max-width: 800px; font-size: 15.5px; color: var(--text-2); margin: 20px 0 0; }
  .tnote strong { color: var(--text); }
  .final { text-align: center; }
  .final .lede { margin-inline: auto; }
</style>

---
import Base from './Base.astro';
const { title, description, h1, eyebrow, lede, noindex = false } = Astro.props;
---
<Base title={title} description={description} noindex={noindex}>
  <section class="section">
    <div class="wrap simple">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1>{h1}</h1>
      {lede && <p class="lede">{lede}</p>}
      <div class="body"><slot /></div>
    </div>
  </section>
</Base>
<style>
  .simple { max-width: 760px; }
  h1 { margin: 12px 0 18px; }
  .body { margin-top: 38px; }
  .body :global(h2) { margin: 40px 0 14px; }
  .body :global(h3) { margin: 28px 0 10px; font-size: 19px; }
  .body :global(p), .body :global(li) { color: var(--text-2); }
  .body :global(ul), .body :global(ol) { padding-left: 20px; margin: 0 0 18px; }
  .body :global(li) { margin-bottom: 8px; }
  .body :global(.note) { border-left: 3px solid var(--accent); background: var(--bg-elev); padding: 16px 20px; border-radius: 0 8px 8px 0; margin: 24px 0; }
</style>

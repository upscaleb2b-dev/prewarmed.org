---
/**
 * Frame for the broad-intent pages in src/data/intents.js.
 *
 * Same three exits as every other page: the orange button to the app, the
 * WhatsApp button, and a quieter link to the matching page on
 * warminboxes.com for someone who wants to read more before buying. The page
 * body is the slot; the questions, related links and closing CTA are here so
 * every intent page ends the same way.
 */
import Simple from './Simple.astro';
import Faq from '../components/Faq.astro';
import Handoff from '../components/Handoff.astro';
import WhatsApp from '../components/WhatsApp.astro';
import { intents, intent } from '../data/intents.js';
import { order, wiUrl } from '../data/site.js';

const { slug, faqs = [], related = [] } = Astro.props;
const p = intent(slug);
const url = `https://prewarmed.org/${slug}/`;
const others = intents.filter((i) => i.slug !== slug).map((i) => [`/${i.slug}/`, i.label]);

const schema = {
  '@graph': [
    { '@type': 'WebPage', '@id': `${url}#page`, url, name: p.h1, description: p.description, isPartOf: { '@id': 'https://prewarmed.org/#site' } },
    { '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://prewarmed.org/' },
      { '@type': 'ListItem', position: 2, name: p.eyebrow, item: url },
    ]},
    ...(faqs.length ? [{ '@type': 'FAQPage', mainEntity: faqs.map(([q, a]) => ({
      '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a },
    }))}] : []),
  ],
};
---
<Simple title={p.title} description={p.description} eyebrow={p.eyebrow} h1={p.h1} lede={p.lede} schema={schema}>
  <div class="ip-cta">
    <a class="btn btn-primary btn-lg" href={order({ page: slug, placement: 'hero' })} target="_blank" rel="noopener">Get inboxes</a>
    <WhatsApp />
    <a class="btn btn-ghost" href={wiUrl(p.wi.url, { page: slug, placement: 'hero' })} target="_blank" rel="noopener">{p.wi.label} ↗</a>
  </div>
  <Handoff />

  <slot />

  {faqs.length > 0 && <div class="ip-faq"><Faq faqs={faqs} /></div>}

  <nav class="ip-rel" aria-label="Related">
    <p class="eyebrow">Related</p>
    <ul>
      {[...related, ...others].map(([href, label]) => <li><a href={href}>{label}</a></li>)}
    </ul>
  </nav>

  <div class="ip-end">
    <p class="ip-end-h">Ready when you are</p>
    <p>Pick the platform and the quantity in the app. If you are not sure which, send us the volume and the market on WhatsApp and we will size it with you.</p>
    <div class="ip-cta">
      <a class="btn btn-primary btn-lg" href={order({ page: slug, placement: 'footer-cta' })} target="_blank" rel="noopener">Get inboxes</a>
      <WhatsApp label="Help me choose" />
    </div>
    <p class="ip-more">More detail on warminboxes.com: <a href={wiUrl(p.wi.url, { page: slug, placement: 'footer-cta' })} target="_blank" rel="noopener">{p.wi.label} ↗</a></p>
  </div>
</Simple>

<style>
  .ip-cta { display: flex; flex-wrap: wrap; gap: 10px; margin: 0 0 4px; }
  .ip-cta .btn { min-height: 44px; display: inline-flex; align-items: center; }
  @media (max-width: 560px) { .ip-cta .btn { flex: 1 1 100%; justify-content: center; } }
  .ip-faq { margin-top: 56px; }
  .ip-rel { margin-top: 48px; padding-top: 24px; border-top: 1px solid var(--border); }
  .ip-rel ul { list-style: none; padding: 0; margin: 10px 0 0; display: flex; flex-wrap: wrap; gap: 8px 18px; }
  .ip-rel li { margin: 0; font-size: 15px; }
  .ip-end { margin-top: 48px; background: var(--bg-elev); border: 1px solid var(--border); border-radius: var(--r-card); padding: 26px 24px; }
  .ip-end-h { font-family: var(--font-display); font-weight: 600; font-size: 22px; color: var(--text) !important; margin: 0 0 8px; }
  .ip-end .ip-cta { margin-top: 18px; }
  .ip-more { font-size: 14px; margin: 14px 0 0; }
</style>

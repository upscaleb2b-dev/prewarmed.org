---
import '../styles/tokens.css';
import '../styles/base.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site.js';

const {
  title,
  description,
  palette = 'ember',
  noindex = false,
  schema = null,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://prewarmed.org').href;
const ogImage = new URL('/og.png', Astro.site ?? 'https://prewarmed.org').href;

/**
 * Organization and WebSite belong on every page, not just the home page, so
 * search engines can resolve the publisher of any page they land on first.
 * Page-level schema is merged into the same graph rather than emitted as a
 * second script, which is what the spec expects.
 */
const baseGraph = [
  {
    '@type': 'Organization',
    '@id': 'https://prewarmed.org/#org',
    name: 'prewarmed.org',
    legalName: site.entity,
    url: 'https://prewarmed.org/',
    logo: 'https://prewarmed.org/icon-512.png',
    description: site.tagline,
    parentOrganization: { '@type': 'Organization', name: site.operator, url: site.operatorUrl },
    sameAs: [site.operatorUrl, site.agencyUrl],
  },
  {
    '@type': 'WebSite',
    '@id': 'https://prewarmed.org/#site',
    url: 'https://prewarmed.org/',
    name: 'prewarmed.org',
    publisher: { '@id': 'https://prewarmed.org/#org' },
  },
];
const graph = {
  '@context': 'https://schema.org',
  '@graph': [...baseGraph, ...(schema?.['@graph'] ?? (schema ? [schema] : []))],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex
      ? <meta name="robots" content="noindex, nofollow" />
      : <meta name="robots" content="index, follow, max-image-preview:large" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="prewarmed.org" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="prewarmed.org — 51 days of reputation, yours today" />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#FF6A1F" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
    />
    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
    {(site.analytics.ga4 || site.analytics.adsId) && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${site.analytics.ga4 || site.analytics.adsId}`}></script>
        <script is:inline set:html={`
          window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}
          gtag('js',new Date());
          ${site.analytics.ga4 ? `gtag('config','${site.analytics.ga4}',{linker:{domains:${JSON.stringify(site.analytics.linkDomains ?? [])}}});` : ''}
          ${(site.analytics.ga4Extra ?? []).map((id) => `gtag('config','${id}',{linker:{domains:${JSON.stringify(site.analytics.linkDomains ?? [])}}});`).join('\n          ')}
          ${site.analytics.adsId ? `gtag('config','${site.analytics.adsId}');` : ''}
        `} />
        <script is:inline set:html={`
          /* Ad click IDs do not survive the handoff on their own.
             wi() builds outbound URLs at build time with UTMs only, so a
             visitor arriving on ?gclid=... reaches warminboxes.com without it
             and Google Ads can never tie the sale back to the click that paid
             for it. Carry the click id across, in sessionStorage so it holds
             through internal navigation. Click ids only — forwarding utm_*
             would overwrite the ones wi() sets on purpose. */
          (function(){
            var KEYS=['gclid','gbraid','wbraid','msclkid'],STORE='pw_click',HOSTS=${JSON.stringify(site.analytics.linkDomains ?? [])};
            var ids={};
            try{ids=JSON.parse(sessionStorage.getItem(STORE)||'{}')}catch(e){}
            var q=new URLSearchParams(location.search),found=false;
            KEYS.forEach(function(k){var v=q.get(k);if(v){ids[k]=v;found=true}});
            if(found){try{sessionStorage.setItem(STORE,JSON.stringify(ids))}catch(e){}}
            var keys=Object.keys(ids);
            if(!keys.length)return;
            function decorate(a){
              if(!a||!a.href)return;
              try{
                var u=new URL(a.href,location.href);
                if(HOSTS.indexOf(u.hostname.replace(/^www\./,''))<0)return;
                keys.forEach(function(k){if(!u.searchParams.has(k))u.searchParams.set(k,ids[k])});
                a.href=u.toString();
              }catch(e){}
            }
            function all(){[].forEach.call(document.querySelectorAll('a[href]'),decorate)}
            document.readyState==='loading'?document.addEventListener('DOMContentLoaded',all):all();
            /* Links written after load (calculator results) get it on the way out. */
            document.addEventListener('click',function(e){var a=e.target&&e.target.closest&&e.target.closest('a[href]');if(a)decorate(a)},true);
          })();
        `} />
      </>
    )}
  </head>
  <body data-palette={palette}>
    <a class="skip" href="#main">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>

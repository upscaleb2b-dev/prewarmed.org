---
/**
 * Every third-party tag, in the order they have to fire.
 *
 * Lifted out of Base.astro so a page that does not use Base (the Alpha
 * Foundation page carries its own document) still measures. The order is
 * load-bearing: consent defaults first, then GTM, then the pixels that have
 * no consent mode, then gtag and the click-id forwarder.
 */
import { site } from '../data/site.js';
---
{/*
  Consent. This has to be the first script on the page: Google Consent
  Mode only works if the defaults are set before gtag.js or GTM loads,
  and Meta and X have no consent mode at all, so they are held back
  entirely rather than loaded in a restricted state.

  Who sees the banner is decided by time zone rather than by IP, because
  an IP lookup would mean calling a third party before consent. The one
  thing the banner exists to prevent. A Europe/* zone is treated as EEA or
  UK: consent defaults to denied, nothing advertising loads, and the
  banner asks. Everywhere else is granted on arrival, which is both the
  ordinary practice and what keeps US ad measurement intact.
*/}
<script is:inline set:html={`
  (function(){
    var KEY='pw_consent';
    window.dataLayer=window.dataLayer||[];
    function gtag(){dataLayer.push(arguments)}
    window.gtag=gtag;
    var stored=null; try{stored=localStorage.getItem(KEY)}catch(e){}
    var tz=''; try{tz=Intl.DateTimeFormat().resolvedOptions().timeZone||''}catch(e){}
    var regulated=/^Europe\\//.test(tz)||/^Atlantic\\/(Canary|Madeira|Azores|Reykjavik|Faroe)$/.test(tz);
    var state = stored || (regulated ? 'pending' : 'granted');
    var v = state==='granted' ? 'granted' : 'denied';
    gtag('consent','default',{
      ad_storage:v, ad_user_data:v, ad_personalization:v, analytics_storage:v,
      functionality_storage:'granted', security_storage:'granted'
    });
    window.__pwConsent={ state:state, regulated:regulated, key:KEY };
  })();
`} />

{site.analytics.gtm && (
  <script is:inline set:html={`(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','${site.analytics.gtm}');`} />
)}

{/* Meta and X ignore Consent Mode, so they only exist once consent is in. */}
{(site.analytics.metaPixel || site.analytics.xPixel || site.analytics.openaiPixel) && (
  <script is:inline set:html={`
    (function(){
      window.__pwLoadAdPixels=function(){
        if(window.__pwAdPixelsLoaded)return; window.__pwAdPixelsLoaded=true;
        ${site.analytics.metaPixel ? `
        !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');
        fbq('init','${site.analytics.metaPixel}'); fbq('track','PageView');` : ''}
        ${site.analytics.xPixel ? `
        !function(e,t,n,s,u,a){e.twq||(s=e.twq=function(){s.exe?s.exe.apply(s,arguments):s.queue.push(arguments);},s.version='1.1',s.queue=[],u=t.createElement(n),u.async=!0,u.src='https://static.ads-twitter.com/uwt.js',a=t.getElementsByTagName(n)[0],a.parentNode.insertBefore(u,a))}(window,document,'script');
        twq('config','${site.analytics.xPixel}');` : ''}
        ${site.analytics.openaiPixel ? `
        !function(w,d,s,u){if(w.oaiq)return;var q=function(){q.q.push(arguments)};q.q=[];w.oaiq=q;var j=d.createElement(s);j.async=1;j.src=u;var f=d.getElementsByTagName(s)[0];f.parentNode.insertBefore(j,f)}(window,document,"script","https://bzrcdn.openai.com/sdk/oaiq.min.js");
        oaiq("init",{pixelId:"${site.analytics.openaiPixel}"});` : ''}
      };
      if(window.__pwConsent && window.__pwConsent.state==='granted') window.__pwLoadAdPixels();
    })();
  `} />
)}
{(site.analytics.ga4 || site.analytics.adsId) && (
  <>
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${site.analytics.ga4 || site.analytics.adsId}`}></script>
    <script is:inline set:html={`
      window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}
      gtag('js',new Date());
      ${site.analytics.ga4 ? `gtag('config','${site.analytics.ga4}',{linker:{domains:${JSON.stringify(site.analytics.linkDomains ?? [])}}});` : ''}
      ${(site.analytics.ga4Extra ?? []).map((id) => `gtag('config','${id}',{linker:{domains:${JSON.stringify(site.analytics.linkDomains ?? [])}}});`).join('\n          ')}
    `} />
    {/*
      Google Ads, as the snippet Google generates, pasted verbatim at the
      site owner's instruction. It brings its own copy of gtag.js: the page
      already loads one above for GA4 and the same library serves every
      config, so this is a second download and a second config of the same
      id. Setting site.analytics.adsId alone did the same job without it.
      Left as the snippet because that is what was asked for; the config
      line it replaced is gone, so the id is configured once, not twice.
    */}
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=AW-17860457598"></script>
    <script is:inline set:html={`
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'AW-17860457598');
    `} />

    <script is:inline set:html={`
      /* Ad click IDs do not survive the handoff on their own.
         wi() builds outbound URLs at build time with UTMs only, so a
         visitor arriving on ?gclid=... reaches warminboxes.com without it
         and Google Ads can never tie the sale back to the click that paid
         for it. Carry the click id across, in sessionStorage so it holds
         through internal navigation. Click ids only, forwarding utm_*
         would overwrite the ones wi() sets on purpose. */
      (function(){
        var KEYS=['gclid','gbraid','wbraid','msclkid'],STORE='pw_click',HOSTS=${JSON.stringify(site.analytics.linkDomains ?? [])};
        var ids={};
        try{ids=JSON.parse(sessionStorage.getItem(STORE)||'{}')}catch(e){}
        var q=new URLSearchParams(location.search),found=false;
        KEYS.forEach(function(k){var v=q.get(k);if(v){ids[k]=v;found=true}});
        if(found){try{sessionStorage.setItem(STORE,JSON.stringify(ids))}catch(e){}}
        var keys=Object.keys(ids);
        if(!keys.length)return;
        function decorate(a){
          if(!a||!a.href)return;
          try{
            var u=new URL(a.href,location.href);
            if(HOSTS.indexOf(u.hostname.replace(/^www\./,''))<0)return;
            keys.forEach(function(k){if(!u.searchParams.has(k))u.searchParams.set(k,ids[k])});
            a.href=u.toString();
          }catch(e){}
        }
        function all(){[].forEach.call(document.querySelectorAll('a[href]'),decorate)}
        document.readyState==='loading'?document.addEventListener('DOMContentLoaded',all):all();
        /* Links written after load (calculator results) get it on the way out. */
        document.addEventListener('click',function(e){var a=e.target&&e.target.closest&&e.target.closest('a[href]');if(a)decorate(a)},true);
      })();
    `} />
  </>
)}

{/*
  The event map, shared with warminboxes.com.

  Four conversions, each sent to every platform under the name that platform
  knows it by, so one action is one conversion everywhere instead of four
  differently-named things nobody can join up. Every send carries an eventID,
  which is what lets Meta's browser copy and its Conversions API copy of the
  same conversion deduplicate rather than count twice. Nothing server-side
  runs here yet; the id costs nothing and means this side is already right
  when it does.

  Each platform call is wrapped on its own. One vendor's SDK throwing must
  not take the other three down with it, and no analytics error is worth
  losing somebody's lead over.

  The pixels are consent-gated, so outside the UK and EEA all four exist and
  inside they exist only once the visitor has accepted. Hence the typeof
  checks rather than assuming.
*/}
<script is:inline set:html={`
  (function(){
    var MAP={
      lead:        {meta:'Lead',              ga4:'generate_lead'},
      contact:     {meta:'Contact',           ga4:'contact'},
      checkout:    {meta:'InitiateCheckout',  ga4:'begin_checkout'},
      application: {meta:'SubmitApplication', ga4:'submit_application'}
    };
    var XEVENT=${JSON.stringify(site.analytics.xLeadEvent || '')};
    /* Google Ads counts a conversion only against a send_to of
       <conversion id>/<label>. Empty until both are set, and then it rides
       on the lead rather than on page load: see the note below. */
    var ADS=${JSON.stringify(site.analytics.adsId && site.analytics.adsLabel
      ? `${site.analytics.adsId}/${site.analytics.adsLabel}` : '')};
    function eid(){
      try{ if(crypto && crypto.randomUUID) return crypto.randomUUID() }catch(e){}
      return 'pw-'+Date.now()+'-'+Math.random().toString(36).slice(2,10);
    }
    window.pwTrack=function(name,params,forcedId){
      var m=MAP[name]; if(!m) return;
      /* forcedId lets the handoff mint the id before it stamps it on the
         outbound URL, so the id on this side and the id that lands on the
         other side are the same string. */
      var id=forcedId||eid(); params=params||{};
      try{ window.dataLayer&&window.dataLayer.push({event:'pw_'+name,eventID:id,pw:params}) }catch(e){}
      try{ if(window.gtag) window.gtag('event',m.ga4,params) }catch(e){}
      try{ if(window.fbq) window.fbq('track',m.meta,params,{eventID:id}) }catch(e){}
      try{ if(window.oaiq) window.oaiq('track',m.meta,params) }catch(e){}
      /* X takes configured conversion ids, not names, and we have one: the
         lead. The other three have nothing to fire at there. */
      try{ if(window.twq && XEVENT && name==='lead') window.twq('event',XEVENT,{}) }catch(e){}
      /* Google Ads, same one moment. The conversion action was created as a
         page view, and its snippet fires on every page it is pasted into,
         which would make every visit a conversion and teach the campaign to
         buy the cheapest traffic it can find. It fires here instead, on the
         action that is actually worth money. */
      try{ if(window.gtag && ADS && name==='lead') window.gtag('event','conversion',{send_to:ADS}) }catch(e){}
      return id;
    };

    /* The handoff. The order is placed on warminboxes.com, so the click that
       leaves this site is the last thing this side can measure, and without
       it every campaign here looks like it produced nothing. Delegated and
       captured, so links written after load are covered too, and read off the
       resolved URL rather than the attribute because wi() builds absolute
       ones with UTMs already on them. */
    document.addEventListener('click',function(e){
      var a=e.target&&e.target.closest&&e.target.closest('a[href]'); if(!a) return;
      var u; try{ u=new URL(a.href,location.href) }catch(err){ return }
      var host=u.hostname.replace(/^www\\./,'');

      if(host==='wa.me'||host==='api.whatsapp.com'){
        return void window.pwTrack('contact',{pw_from:location.pathname});
      }
      if(host!=='warminboxes.com' && host!=='app.warminboxes.com') return;

      /* The handoff id. Minted here, stamped on the URL the visitor is about
         to follow, and used as the event id on this side, so the same string
         exists in this property and in the landing URL over there. That is
         what makes the two halves joinable even when cross-domain linking
         fails, which it does whenever a browser drops the _gl parameter.

         set(), not append: a second click on the same link replaces the id
         rather than stacking a second one on the query string. */
      var hid=eid();
      try{ u.searchParams.set('pw_hid',hid); a.href=u.toString(); }catch(err){}

      /* pw_ prefixed because GA4 only reports a custom parameter once it is
         registered as a custom dimension, and an unprefixed name like
         "placement" or "from" is one collision away from something GA4 or a
         GTM template already owns. */
      var p={
        pw_hid: hid,
        pw_dest: host,
        pw_placement: u.searchParams.get('utm_content') || '',
        pw_campaign: u.searchParams.get('utm_campaign') || '',
        pw_from: location.pathname
      };
      window.pwTrack(/^\\/affiliate/.test(u.pathname)?'application':'checkout',p,hid);
    },true);
  })();
`} />

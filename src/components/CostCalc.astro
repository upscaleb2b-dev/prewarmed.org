---
/**
 * Home-page cost calculator.
 *
 * Fresh inboxes cost less a month; prewarmed ones send from the day they
 * arrive. Both are delivered in 48 to 72 hours and both are warmed by Warm
 * Inboxes, so the only real difference over a first quarter is the 14 to 21
 * days a fresh fleet spends warming before it can send. This measures cost
 * per thousand cold emails ACTUALLY SENT over 90 days, on Warm Inboxes'
 * published prices, and reports whichever side wins. At volume fresh often
 * does, and the copy says so rather than hiding it.
 *
 * Assumptions, all stated under the result: quarterly billing on both sides
 * (the 90-day window), fresh at the order-size tier it qualifies for, a $12
 * one-off domain per three fresh inboxes, and the full 21 days of warmup.
 */
import { order } from '../data/site.js';
import pricing from '../data/pricing.json';
import { rate } from '../data/volume.js';
import Handoff from './Handoff.astro';
import WhatsApp from './WhatsApp.astro';

const P = pricing.products;
const cfg = {
  readyDays: 21,
  windowDays: 90,
  domain: P['domain-fresh'].price,
  // Mailboxes per tenant -> cold sends per mailbox per day. A lighter tenant
  // sends more per address for the same flat price.
  tenantRate: { 25: rate('azure-25'), 49: rate('azure-50'), 100: rate('azure-100') },
  platforms: [
    { id: 'google', label: 'Google Workspace', shape: 'pack', perDay: rate('google'),
      pre: P['google-prewarmed'].perUnit.quarterly,
      freshTiers: P['google-fresh'].tiers.map((t) => ({ min: t.min, price: t.perUnit.quarterly })),
      slug: 'prewarmed-google-inboxes' },
    { id: 'microsoft', label: 'Microsoft 365', shape: 'pack', perDay: rate('microsoft'),
      pre: P['microsoft-prewarmed'].perUnit.quarterly,
      freshTiers: [{ min: 1, price: P['microsoft-fresh'].perUnit.quarterly }],
      slug: 'prewarmed-microsoft-365-inboxes' },
    { id: 'azure', label: 'Azure tenant', shape: 'tenant', per: P['azure-tenant'].inboxesPerTenant,
      pre: P['azure-tenant'].perTenant.quarterly,
      fresh: P['azure-fresh'].perTenant.quarterly, slug: 'prewarmed-azure-inboxes' },
  ],
};
---
<section class="cc" data-cfg={JSON.stringify(cfg)}>
  <div class="wrap">
    <p class="pill">Cost calculator</p>
    <h2>What does the warmup wait actually cost you?</h2>
    <p class="sub">Fresh inboxes cost less a month and send nothing for their first 14 to 21 days. Measure both against cold emails actually sent in a first quarter and see which wins at your size.</p>

    <div class="panel">
      <div class="tabs" role="tablist">
        {cfg.platforms.map((p, i) => (
          <button class={`tab${i === 0 ? ' on' : ''}`} data-p={p.id} role="tab" aria-selected={i === 0 ? 'true' : 'false'} type="button">{p.label}</button>
        ))}
      </div>

      <div class="slide">
        <label for="cc-n">Inboxes you need</label>
        <output id="cc-nout" class="mono">15 inboxes</output>
        <input id="cc-n" type="range" min="3" max="300" step="1" value="15" />
      </div>

      <div class="dens" id="cc-dens" hidden>
        <span class="dens-l">Mailboxes per tenant</span>
        <div class="dens-btns" id="cc-dens-btns"></div>
      </div>

      <div class="cards">
        <div class="c"><p class="n mono" id="cc-blocked">…</p><p class="l">Cold emails a fresh fleet cannot send during its warmup</p></div>
        <div class="c"><p class="n mono" id="cc-fresh">…</p><p class="l" id="cc-fresh-l">Fresh: cost per 1,000 emails actually sent in your first 90 days</p></div>
        <div class="c win"><p class="n mono" id="cc-pre">…</p><p class="l" id="cc-pre-l">Prewarmed: cost per 1,000 emails actually sent in the same 90 days</p></div>
        <div class="c good"><p class="n mono" id="cc-delta">…</p><p class="l" id="cc-delta-l">…</p></div>
      </div>

      <p class="say" id="cc-say">…</p>

      <div class="cta">
        <a class="btn btn-primary btn-lg" id="cc-cta" href={order({ page: 'cost-calculator', placement: 'result' })} target="_blank" rel="noopener">Get prewarmed inboxes</a>
        <a class="btn btn-ghost btn-lg" id="cc-more" href="/prewarmed-google-inboxes/">See what ships →</a> <WhatsApp />
      </div>
      <Handoff />
      <p class="foot" id="cc-foot">…</p>
    </div>
  </div>
</section>

<script is:inline>
(() => {
  const root = document.querySelector('.cc');
  if (!root) return;
  const C = JSON.parse(root.dataset.cfg);
  const $ = (id) => document.getElementById(id);
  const money = (n) => '$' + (Number.isInteger(n) ? n.toLocaleString('en-US') : n >= 100 ? Math.round(n).toLocaleString('en-US') : n.toFixed(2));
  const num = (n) => Math.round(n).toLocaleString('en-US');
  let active = C.platforms[0];
  let density = 100;

  function render() {
    const n = +$('cc-n').value;
    $('cc-nout').textContent = n + ' inboxes';

    const tenant = active.shape === 'tenant';
    const perDay = tenant ? C.tenantRate[density] : active.perDay;
    const sendDays = C.windowDays - C.readyDays;
    const months = C.windowDays / 30;
    const preEmails = n * perDay * C.windowDays;
    const freshEmails = n * perDay * sendDays;
    $('cc-blocked').textContent = num(n * perDay * C.readyDays);

    let preCost, freshCost, freshNote;
    if (tenant) {
      const tenants = Math.ceil(n / density);
      preCost = tenants * active.pre * months;
      freshCost = tenants * active.fresh * months + tenants * C.domain;
      freshNote = `${tenants} ${tenants === 1 ? 'tenant' : 'tenants'} at ${money(active.fresh)} plus ${money(C.domain)} a domain`;
    } else {
      const tier = active.freshTiers.filter((t) => n >= t.min).pop();
      const domains = Math.ceil(n / 3);
      preCost = n * active.pre * months;
      freshCost = n * tier.price * months + domains * C.domain;
      freshNote = `${money(tier.price)} an inbox plus ${domains} ${domains === 1 ? 'domain' : 'domains'} at ${money(C.domain)}`;
    }
    const preK = (preCost / preEmails) * 1000;
    const freshK = (freshCost / freshEmails) * 1000;
    const preWins = preK <= freshK;
    const pct = Math.round(Math.abs(1 - (preWins ? preK / freshK : freshK / preK)) * 100);

    $('cc-fresh').textContent = money(freshK);
    $('cc-fresh-l').textContent = `Fresh${tenant ? ' tenant' : ''}: cost per 1,000 emails actually sent in your first 90 days`;
    $('cc-pre').textContent = money(preK);
    $('cc-pre-l').textContent = `Prewarmed${tenant ? ' tenant' : ''}: cost per 1,000 emails actually sent in the same 90 days`;
    const even = pct < 2;
    $('cc-delta').textContent = even ? 'Even' : pct + '%';
    $('cc-delta-l').textContent = even
      ? 'About the same per email sent at this size, and prewarmed sends three weeks sooner'
      : preWins
      ? 'Prewarmed is cheaper per email sent, because nothing is spent waiting'
      : 'Fresh is cheaper per email sent at this size; prewarmed buys you the three weeks';
    // Highlight whichever side actually wins.
    $('cc-pre').parentElement.classList.toggle('win', preWins || even);
    $('cc-fresh').parentElement.classList.toggle('win', !preWins && !even);
    $('cc-say').innerHTML =
      `Over 90 days, ${n} fresh ${active.label} inboxes cost <strong>${money(freshCost)}</strong> (${freshNote}) and send ${num(freshEmails)} cold emails, because the first ${C.readyDays} days go on warmup. The same ${n} prewarmed inboxes cost <strong>${money(preCost)}</strong> and send ${num(preEmails)}, from the day they arrive. That is <strong>${money(preK)} per thousand against ${money(freshK)}</strong>. ` +
      (even ? 'At this size they cost about the same per email, so prewarmed is the three weeks for nothing.'
        : preWins ? 'Prewarmed is the cheaper way to send here as well as the faster one.'
        : 'Fresh is the cheaper way to send here. Prewarmed is the price of starting three weeks sooner, which is worth it when a campaign has a date.');
    $('cc-foot').textContent =
      `Assumes ${perDay} cold emails per ${tenant ? 'mailbox' : 'inbox'} per day${tenant ? ` at ${density} mailboxes to a tenant` : ' and three inboxes to a domain'}, quarterly billing on both sides, and the full 21 days of fresh warmup (at 14 days fresh comes out a little cheaper). Fresh domains are ${money(C.domain)} one off, or free if you bring your own. Both are delivered within 48 to 72 hours and neither needs a warmup tool.`;
    $('cc-more').href = '/' + active.slug + '/';
  }

  const densWrap = $('cc-dens');
  function buildDensity() {
    const show = Array.isArray(active.densities);
    densWrap.hidden = !show;
    if (!show) { density = 100; return; }
    if (!active.densities.some((d) => d.inboxes === density)) density = active.densities[active.densities.length - 1].inboxes;
    $('cc-dens-btns').innerHTML = active.densities.map((d) =>
      `<button type="button" class="db${d.inboxes === density ? ' on' : ''}" data-d="${d.inboxes}">${d.inboxes}<span>$${(active.pre / d.inboxes).toFixed(2)}/inbox · ${d.risk.toLowerCase()}</span></button>`).join('');
    $('cc-dens-btns').querySelectorAll('.db').forEach((b) => b.addEventListener('click', () => {
      density = +b.dataset.d; buildDensity(); render();
    }));
  }

  root.querySelectorAll('.tab').forEach((b) => b.addEventListener('click', () => {
    root.querySelectorAll('.tab').forEach((x) => { x.classList.remove('on'); x.setAttribute('aria-selected', 'false'); });
    b.classList.add('on'); b.setAttribute('aria-selected', 'true');
    active = C.platforms.find((p) => p.id === b.dataset.p);
    buildDensity();
    render();
  }));
  $('cc-n').addEventListener('input', render);
  buildDensity();
  render();
})();
</script>

<style>
  .cc { padding-block: 72px; background: var(--bg-elev); border-block: 1px solid var(--border); text-align: center; }
  .pill { display: inline-block; font-size: 11.5px; letter-spacing: .09em; text-transform: uppercase; color: var(--accent); background: var(--accent-soft); border: 1px solid color-mix(in srgb, var(--accent) 30%, transparent); border-radius: 999px; padding: 6px 14px; margin: 0 0 18px; font-weight: 600; }
  .cc h2 { margin: 0 auto 14px; max-width: 700px; }
  .sub { max-width: 620px; margin: 0 auto; color: var(--text-2); font-size: 16.5px; }
  .panel { max-width: 720px; margin: 32px auto 0; background: var(--bg); border: 1px solid var(--border); border-radius: var(--r-card); padding: 26px; text-align: left; }
  .tabs { display: flex; gap: 8px; flex-wrap: wrap; justify-content: center; }
  .tab { background: var(--bg-elev); border: 1px solid var(--border); color: var(--text-2); border-radius: 999px; padding: 8px 16px; font-size: 14px; font-weight: 500; cursor: pointer; font-family: inherit; }
  .tab.on { border-color: var(--accent); color: var(--accent); background: var(--accent-soft); }

  .slide { margin-top: 26px; display: grid; grid-template-columns: 1fr auto; gap: 8px 12px; align-items: baseline; }
  .slide label { font-size: 13.5px; color: var(--text-2); font-weight: 500; }
  .slide output { font-size: 16px; color: var(--text); font-weight: 500; }
  .slide input { grid-column: 1 / -1; width: 100%; accent-color: var(--accent); height: 22px; }
  @media (max-width: 860px) { .tab { padding: 14px 18px; } .slide input { height: 44px; } }
  .dens { margin-top: 20px; }
  .dens-l { display: block; font-size: 13.5px; color: var(--text-2); font-weight: 500; margin-bottom: 8px; }
  .dens-btns { display: flex; gap: 8px; flex-wrap: wrap; }
  .dens-btns :global(.db) { flex: 1 1 140px; background: var(--bg-elev); border: 1px solid var(--border); border-radius: 8px; padding: 9px 12px; cursor: pointer; font-family: inherit; color: var(--text); font-size: 17px; font-weight: 500; text-align: left; }
  .dens-btns :global(.db span) { display: block; font-size: 11.5px; color: var(--text-muted); font-weight: 400; margin-top: 2px; }
  .dens-btns :global(.db.on) { border-color: var(--accent); background: var(--accent-soft); color: var(--accent); }
  .dens-btns :global(.db.on span) { color: var(--text-2); }
  .cards { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; margin-top: 22px; }
  @media (max-width: 560px) { .cards { grid-template-columns: 1fr; } }
  .c { background: var(--bg-elev); border: 1px solid var(--border); border-radius: 10px; padding: 16px 18px; }
  .c.win { border-color: var(--accent); background: var(--accent-soft); }
  .c.good { border-color: color-mix(in srgb, var(--success, #3fb950) 45%, transparent); }
  .c .n { font-size: 27px; font-weight: 500; color: var(--text); letter-spacing: -.02em; margin: 0 0 6px; }
  .c.win .n { color: var(--accent); }
  .c.good .n { color: var(--success, #3fb950); }
  .c .l { font-size: 12.5px; color: var(--text-muted); margin: 0; line-height: 1.4; }
  .say { margin: 20px 0 0; padding: 14px 16px; background: var(--bg-elev); border-left: 3px solid var(--accent); border-radius: 0 8px 8px 0; font-size: 15px; color: var(--text-2); }
  .say strong { color: var(--text); }
  .cta { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 22px; }
  .foot { font-size: 12.5px; color: var(--text-muted); margin: 16px 0 0; line-height: 1.5; }
  .foot strong { color: var(--text-2); }
</style>

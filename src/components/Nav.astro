---
import { nav, site, wi, toolUrl } from '../data/site.js';
import tools from '../data/tools.json';
import leads from '../data/leads.json';
import Flame from './Flame.astro';

const groups = [
  { id: 'diagnose', label: 'Diagnose' },
  { id: 'authenticate', label: 'Authenticate' },
  { id: 'hygiene', label: 'List hygiene' },
  { id: 'qa', label: 'Pre-send QA' },
  { id: 'plan', label: 'Plan' },
];
const live = tools.tools.filter((t) => t.live);
const path = Astro.url.pathname;
const leadCats = leads.categories.slice(0, 12);
const leadsM = (leads.totalLeads / 1_000_000).toFixed(0);
---
<header class="nav">
  <div class="wrap nav-inner">
    <a class="brand" href="/"><Flame size={20} />prewarmed<span class="muted">.org</span></a>

    <nav class="links" aria-label="Main">
      {nav.map((item) => (
        <div class={[
          (item.children || item.mega || item.leads) && 'has-menu',
          (item.mega || item.leads) && 'has-mega',
        ].filter(Boolean).join(' ')}>
          <a href={item.href}
             target={item.external ? '_blank' : undefined}
             rel={item.external ? 'noopener' : undefined}
             aria-current={!item.external && path.startsWith(item.href) && item.href !== '/' ? 'page' : undefined}>
            {item.label}{item.external && <span class="ext" aria-hidden="true">↗</span>}{(item.children || item.mega || item.leads) && <span class="caret" aria-hidden="true">▾</span>}
          </a>

          {item.children && (
            <div class="menu">
              {item.children.map((c) => <a href={c.href}>{c.label}</a>)}
            </div>
          )}

          {item.leads && (
            <div class="mega leads-mega">
              <div class="leads-head">
                <div>
                  <p class="eyebrow">Free B2B lead lists</p>
                  <p class="leads-stat"><b class="mono">{leads.totalLists}</b> lists · <b class="mono">{leadsM}M+</b> contacts · free, no signup</p>
                </div>
                <a class="btn btn-primary" href="/leads/">Browse all →</a>
              </div>
              <div class="leads-grid">
                {leadCats.map((c) => (
                  <a class="lead-cat" href="/leads/">
                    <span class="cn">{c.name}</span>
                    <span class="cm mono">{c.lists} lists</span>
                  </a>
                ))}
              </div>
            </div>
          )}

          {item.mega && (
            <div class="mega">
              <div class="mega-grid">
                {groups.map((g) => (
                  <div>
                    <p class="eyebrow">{g.label}</p>
                    {live.filter((t) => t.group === g.id).slice(0, 7).map((t) => (
                      <a class="tool-link" href={toolUrl(t, { page: 'nav', placement: 'mega-menu' })} target={t.host === 'prewarmed.org' ? undefined : '_blank'} rel={t.host === 'prewarmed.org' ? undefined : 'noopener'}>
                        {t.name}{t.host !== 'prewarmed.org' && <span class="ext" aria-label="opens warminboxes.com"> ↗</span>}
                      </a>
                    ))}
                  </div>
                ))}
              </div>
              <div class="mega-promo">
                <p><strong>Domain flagged? Failed a check?</strong> Prewarmed inboxes ship the same day, on a domain that has already done its 51 days.</p>
                <div class="mega-cta">
                  <a class="btn btn-primary" href="/prewarmed-inboxes/">See inboxes</a>
                  <a href="/tools/">All {live.length} free tools →</a>
                </div>
              </div>
            </div>
          )}
        </div>
      ))}
    </nav>

    <div class="nav-cta">
      <a class="btn btn-primary" href={wi('/', { page: 'nav', placement: 'header' })} target="_blank" rel="noopener">Get inboxes</a>
      <button class="burger" type="button" aria-expanded="false" aria-controls="m-nav" aria-label="Open menu">
        <span aria-hidden="true"></span><span aria-hidden="true"></span><span aria-hidden="true"></span>
      </button>
    </div>
  </div>

</header>

  <div class="m-nav" id="m-nav" hidden>
    <div class="wrap">
      {nav.map((item) => (
        <div class="m-grp">
          <a class="m-top" href={item.href}
             target={item.external ? '_blank' : undefined}
             rel={item.external ? 'noopener' : undefined}>
            {item.label}{item.external && <span class="ext" aria-hidden="true">↗</span>}
          </a>
          {item.children && (
            <div class="m-sub">{item.children.map((c) => <a href={c.href}>{c.label}</a>)}</div>
          )}
          {item.mega && <div class="m-sub"><a href="/tools/">All {live.length} free tools</a></div>}
          {item.leads && <div class="m-sub"><a href="/leads/">{leads.totalLists} lists · {leadsM}M+ contacts</a></div>}
        </div>
      ))}
      <a class="btn btn-primary m-cta" href={wi('/', { page: 'nav', placement: 'mobile-menu' })} target="_blank" rel="noopener">Get inboxes</a>
    </div>
  </div>


<script is:inline>
  /* The mobile panel fills everything below the header. That used to be a
     hardcoded 65px, which only held while the header sat at the very top of
     the viewport — the bar above it broke that. Measure instead, and keep it
     current as the sticky header moves under the bar on scroll. */
  (function () {
    var nav = document.querySelector('.nav');
    if (!nav) return;
    var bar = document.querySelector('.xbar');
    var set = function () {
      if (bar) {
        document.documentElement.style.setProperty(
          '--xbar-h', Math.round(bar.getBoundingClientRect().height) + 'px');
      }
      document.documentElement.style.setProperty(
        '--hdr-bottom', Math.max(0, Math.round(nav.getBoundingClientRect().bottom)) + 'px');
    };
    set();
    addEventListener('scroll', set, { passive: true });
    addEventListener('resize', set, { passive: true });
  })();
</script>

<script is:inline>
  (() => {
    // Desktop dropdowns. CSS :hover alone loses the menu whenever the cursor
    // crosses the gap between the nav item and the panel, or travels
    // diagonally toward a column that is not directly below the item. A short
    // close delay forgives both, which is what the hand actually does.
    const items = [...document.querySelectorAll('.links > div.has-menu')];
    let closeTimer, switchTimer;
    const openOnly = (el) => { items.forEach((x) => x.classList.toggle('open', x === el)); };
    const closeAll = () => items.forEach((x) => x.classList.remove('open'));
    const stop = () => { clearTimeout(closeTimer); clearTimeout(switchTimer); };
    items.forEach((el) => {
      el.addEventListener('mouseenter', () => {
        stop();
        // The wide panels start at the page gutter, so reaching a column on
        // the left means crossing the triggers that sit between. Switching
        // instantly would swap the menu out from under the cursor, so a
        // different menu has to be dwelt on before it takes over.
        const somethingOpen = items.some((x) => x.classList.contains('open'));
        if (somethingOpen && !el.classList.contains('open')) switchTimer = setTimeout(() => openOnly(el), 160);
        else openOnly(el);
      });
      el.addEventListener('mouseleave', () => { stop(); closeTimer = setTimeout(closeAll, 260); });
      el.addEventListener('focusin', () => { stop(); openOnly(el); });
      el.addEventListener('focusout', (e) => { if (!el.contains(e.relatedTarget)) el.classList.remove('open'); });
    });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') { stop(); closeAll(); } });
  })();

  (() => {
    const btn = document.querySelector('.burger');
    const panel = document.getElementById('m-nav');
    if (!btn || !panel) return;
    const set = (open) => {
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      panel.hidden = !open;
      document.body.style.overflow = open ? 'hidden' : '';
    };
    btn.addEventListener('click', () => set(panel.hidden));
    panel.addEventListener('click', (e) => { if (e.target.closest('a')) set(false); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !panel.hidden) { set(false); btn.focus(); } });
    // A resize past the breakpoint must not leave the body scroll-locked.
    matchMedia('(min-width: 1121px)').addEventListener('change', (e) => e.matches && set(false));
  })();
</script>

<style>
  .nav { position: sticky; top: var(--xbar-h, 44px); z-index: 40; background: var(--bg); border-bottom: 1px solid var(--border); }
  .nav-inner { display: flex; align-items: center; gap: 28px; min-height: 64px; position: relative; }
  .brand { display: inline-flex; align-items: center; gap: 8px; padding-block: 10px; font-family: var(--font-display); font-weight: 700; font-size: 18px; letter-spacing: -.03em; color: var(--text); }
  .brand:hover { text-decoration: none; }
  .links { display: flex; gap: 4px; margin-right: auto; }
  .links > div { position: relative; }
  /* Wide panels measure from the header's gutter so they cannot overflow the
     viewport; the narrow dropdowns stay pinned to their own nav item. */
  .links > div.has-mega { position: static; }
  .links > div > a { display: inline-flex; align-items: center; gap: 5px; padding: 9px 12px; border-radius: 6px; font-size: 15px; font-weight: 500; color: var(--text-2); white-space: nowrap; }
  /* Seven items, a brand and a CTA do not fit at full spacing on a 1280
     laptop; without this the labels wrap to two lines. */
  @media (max-width: 1400px) {
    .nav-inner { gap: 18px; }
    .links > div > a { padding: 9px 9px; font-size: 14.5px; }
  }
  .links > div > a:hover, .links > div > a[aria-current] { color: var(--text); background: var(--bg-elev); text-decoration: none; }
  .caret { font-size: 10px; color: var(--text-muted); }
  /* The panels sit 6px (17px for the wide ones) below the item they hang off.
     That gap is not part of any hovered element, so the cursor crossing it
     dropped :hover and the menu vanished before it could be reached. This
     bridges the gap with an invisible extension of the panel itself. */
  .menu::before, .mega::before { content: ''; position: absolute; left: 0; right: 0; top: -20px; height: 20px; }
  .menu, .mega { position: absolute; top: calc(100% + 6px); left: 0; background: var(--bg-elev); border: 1px solid var(--border); border-radius: var(--r-card); padding: 10px; display: none; box-shadow: 0 12px 32px rgba(0,0,0,.45); }
  .menu { min-width: 220px; flex-direction: column; }
  .menu a { display: block; padding: 9px 12px; border-radius: 6px; font-size: 15px; color: var(--text-2); }
  .menu a:hover { background: var(--bg-elev-2); color: var(--text); text-decoration: none; }
  .mega { left: 24px; width: min(920px, calc(100vw - 48px)); max-width: 100%; padding: 22px; }
  .leads-mega { width: min(720px, calc(100vw - 48px)); }
  .leads-head { display: flex; align-items: center; justify-content: space-between; gap: 20px; flex-wrap: wrap; padding-bottom: 16px; margin-bottom: 16px; border-bottom: 1px solid var(--border); }
  .leads-head .eyebrow { margin: 0 0 6px; }
  .leads-stat { margin: 0; font-size: 14px; color: var(--text-2); }
  .leads-stat b { color: var(--text); font-weight: 500; }
  .leads-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2px 18px; }
  .lead-cat { display: flex; justify-content: space-between; gap: 10px; align-items: baseline; padding: 7px 0; font-size: 13.5px; color: var(--text-2); border-bottom: 1px solid var(--border); }
  .lead-cat:hover { color: var(--accent); text-decoration: none; }
  .cm { font-size: 10.5px; color: var(--text-muted); white-space: nowrap; }
  .mega-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 20px; }
  .mega-grid .eyebrow { margin: 0 0 10px; }
  .tool-link { display: block; font-size: 13.5px; color: var(--text-2); padding: 5px 0; line-height: 1.35; }
  .tool-link:hover { color: var(--accent); text-decoration: none; }
  .ext { color: var(--text-muted); font-size: 11px; }
  .mega-promo { margin-top: 18px; padding-top: 16px; border-top: 1px solid var(--border); display: flex; align-items: center; gap: 20px; flex-wrap: wrap; }
  .mega-promo p { margin: 0; font-size: 14.5px; color: var(--text-2); }
  .mega-cta { display: flex; align-items: center; gap: 16px; margin-left: auto; font-size: 14px; }
  .has-menu:hover .menu, .has-menu:hover .mega,
  .has-menu:focus-within .menu, .has-menu:focus-within .mega,
  .has-menu.open .menu, .has-menu.open .mega { display: flex; }
  .mega { flex-direction: column; }
  .nav-cta { display: flex; gap: 10px; align-items: center; }
  .nav-cta .btn { white-space: nowrap; }
  /* At 390px the brand, the CTA and the burger do not fit at desktop sizing;
     without this the header pushes the whole page into horizontal scroll. */
  @media (max-width: 520px) {
    .nav-inner { gap: 12px; }
    .brand { font-size: 16px; }
    .nav-cta { gap: 8px; }
    .nav-cta .btn { padding-inline: 12px; font-size: 13.5px; white-space: nowrap; }
  }
  /* 360px (iPhone SE and small Android) needs a tighter header gutter than the
     rest of the page, or the brand, the CTA and the burger do not fit. */
  @media (max-width: 400px) {
    .nav-inner { padding-inline: 16px; gap: 10px; }
    .brand { font-size: 15px; }
    .brand :global(svg) { width: 18px; height: 18px; }
    .nav-cta .btn { padding-inline: 10px; }
    .burger { width: 36px; height: 36px; }
  }
  /* Below 360px the brand, the CTA and the burger cannot all fit. Horizontal
     page scroll is the worse defect, so the header CTA goes: the mobile menu
     carries one and the hero CTA is on screen already. */
  @media (max-width: 359px) {
    .nav-cta .btn { display: none; }
  }

  .burger { flex: 0 0 auto; display: none; width: 44px; height: 44px; align-items: center; justify-content: center; flex-direction: column; gap: 4px; background: none; border: 1px solid var(--border); border-radius: 8px; cursor: pointer; padding: 0; }
  .burger span { display: block; width: 17px; height: 1.5px; background: var(--text); border-radius: 2px; }
  .burger[aria-expanded='true'] { border-color: var(--accent); }

  .m-nav { display: none; }

  @media (max-width: 1120px) {
    .links { display: none; }
    .nav-inner { justify-content: space-between; }
    .burger { display: flex; }
    /* Below this width the desktop links are hidden, so without this panel
       the site has no navigation at all. */
    .m-nav { display: block; position: fixed; inset: var(--hdr-bottom, 65px) 0 0; z-index: 60; background: var(--bg); border-top: 1px solid var(--border); overflow-y: auto; padding: 22px 0 40px; }
    .m-nav[hidden] { display: none; }
    .m-grp { border-bottom: 1px solid var(--border); padding: 4px 0 12px; }
    .m-top { display: block; padding: 12px 0 6px; font-size: 17px; font-weight: 500; color: var(--text); }
    .m-sub { display: flex; flex-wrap: wrap; gap: 6px 18px; padding-bottom: 6px; }
    .m-sub a { font-size: 14.5px; color: var(--text-2); padding: 4px 0; }
    .m-cta { margin-top: 24px; width: 100%; justify-content: center; }
  }
</style>

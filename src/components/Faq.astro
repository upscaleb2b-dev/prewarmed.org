---
const { faqs, heading = 'Questions' } = Astro.props;
---
<section class="faq">
  <h2>{heading}</h2>
  <div class="items">
    {faqs.map(([q, a]) => (
      <details>
        <summary>{q}</summary>
        <div class="a"><p>{a}</p></div>
      </details>
    ))}
  </div>
</section>
<style>
  .faq h2 { margin-bottom: 22px; }
  .items { border-top: 1px solid var(--border); }
  details { border-bottom: 1px solid var(--border); }
  summary { cursor: pointer; padding: 18px 0; font-family: var(--font-display); font-weight: 600; font-size: 17px; list-style: none; display: flex; justify-content: space-between; gap: 16px; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; color: var(--accent); font-weight: 500; font-size: 20px; line-height: 1; }
  details[open] summary::after { content: '−'; }
  .a { padding: 0 0 20px; color: var(--text-2); max-width: 70ch; font-size: 16px; }
</style>

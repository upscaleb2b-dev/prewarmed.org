---
/**
 * The Alpha Foundation disclosure page, as its own document.
 *
 * It does not use Base.astro. This is the one page on the site that is not
 * selling anything, and wrapping it in the product nav, the WhatsApp bar and
 * the dark product palette would read as a sales page about a charity, which
 * is the opposite of what it is for. So it carries its own typography and
 * its own light palette, and borrows only the two things that have to be
 * everywhere: the tag stack and the consent banner.
 *
 * Rendered at two URLs. /alpha-foundation/ is its permanent home. While
 * site.alphaMode is on it is also what the front page serves, so the crumb
 * and the lead-in adapt rather than linking the page to itself.
 */
import { site } from '../data/site.js';
import Tracking from './Tracking.astro';
import Consent from './Consent.astro';

const a = site.alpha;
const atRoot = Astro.url.pathname === '/';
/**
 * One canonical URL, whichever route rendered this.
 *
 * While alphaMode is on the same page answers at / and at
 * /alpha-foundation/, and two indexable copies of one page compete with each
 * other. /alpha-foundation/ is the permanent address, so that is the one
 * search engines are pointed at. The front page still serves the content; it
 * just does not claim to be its home.
 */
const canonical = new URL('/alpha-foundation/', Astro.site ?? 'https://prewarmed.org').href;

// Built here rather than inline: Astro treats <title> as raw text and keeps
// only the first expression in it, so a title assembled from parts silently
// loses everything after the first one.
const pageTitle = `${a.name}: Nonprofit and Community Impact. prewarmed.org`;

const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'NGO',
      '@id': `${a.url}/#org`,
      name: a.name,
      url: `${a.url}/`,
      email: a.email,
      identifier: a.charityId,
      address: {
        '@type': 'PostalAddress',
        streetAddress: a.address.street,
        addressLocality: a.address.city,
        postalCode: a.address.postal,
        addressCountry: a.address.country,
      },
    },
    {
      '@type': 'Organization',
      '@id': 'https://prewarmed.org/#org',
      name: 'prewarmed.org',
      legalName: site.entity,
      url: 'https://prewarmed.org/',
      logo: 'https://prewarmed.org/icon-512.png',
      funding: { '@id': `${a.url}/#org` },
    },
    {
      '@type': 'WebPage',
      url: canonical,
      name: `${a.name} and PreWarmed`,
      about: { '@id': `${a.url}/#org` },
      isPartOf: { '@type': 'WebSite', name: 'prewarmed.org', url: 'https://prewarmed.org/' },
    },
  ],
};
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<title>{pageTitle}</title>
<meta name="description" content={`PreWarmed is a commercial service whose net proceeds go to ${a.name}, Charity ID ${a.charityId}, in ${a.address.city}, Pakistan. How the two are connected, and where the money goes.`} />
<link rel="canonical" href={canonical} />
<meta name="robots" content="index, follow, max-image-preview:large" />
<meta name="theme-color" content="#FF6A1F" />
<meta property="og:title" content={`${a.name} and PreWarmed`} />
<meta property="og:description" content={`PreWarmed sells email infrastructure. Its net proceeds go to ${a.name}'s charitable work.`} />
<meta property="og:url" content={canonical} />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="prewarmed.org" />
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600&family=Public+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
<script type="application/ld+json" set:html={JSON.stringify(graph)} />
<Tracking />
</head>
<body>
<a class="skip" href="#main">Skip to content</a>

<header class="site">
  <div class="wrap">
    <div class="crumb">
      {atRoot
        ? <span><b>prewarmed.org</b> / {a.name}</span>
        : <span><a href="/">prewarmed.org</a> / {a.name}</span>}
    </div>
    <nav class="local" aria-label="On this page">
      <a href="#relationship">How we are connected</a>
      <a href="#money">Where the money goes</a>
      <a href="#purchases">Purchases vs donations</a>
      <a href="#contact">Contact</a>
    </nav>
  </div>
</header>

<main id="main">
  <div class="wrap intro">
    <h1>{a.name}: nonprofit and community impact</h1>
    <p class="lede">PreWarmed is a commercial service that exists to fund charitable work. It sells email infrastructure to businesses, and all of its net proceeds go to {a.name}, a charitable organization in {a.address.city}, Pakistan.</p>
  </div>

  <div class="wrap layout">
    <div>
      <section class="block" id="relationship" aria-labelledby="rel-h">
        <h2 id="rel-h">How PreWarmed and {a.name} are connected</h2>
        <div class="prose">
          <p>They are two separate things with one purpose. PreWarmed is the business: it sells prewarmed inboxes, domains and deliverability services at commercial prices. {a.name} is the charity: it carries out the charitable work that PreWarmed's proceeds pay for.</p>
          <p>PreWarmed is operated by {site.entity}, the team behind Warm Inboxes (warminboxes.com) and Upscale B2B (upscaleb2b.com). Orders made through prewarmed.org are fulfilled by Warm Inboxes.</p>
        </div>

        <div class="split">
          <div class="entity commercial">
            <h3>PreWarmed</h3>
            <p>Commercial service. Sells email infrastructure to businesses. Operated by {site.entity}.</p>
          </div>
          <div class="entity nonprofit">
            <h3>{a.name}</h3>
            <p>Charitable organization, Charity ID {a.charityId}, based in {a.address.city}, Pakistan. Receives PreWarmed's net proceeds.</p>
          </div>
        </div>
      </section>

      <section class="block" id="money" aria-labelledby="money-h">
        <h2 id="money-h">Where the money goes</h2>
        <ol class="flow">
          <li class="to-brand"><strong>You place an order through prewarmed.org.</strong> Payment is taken and the order is fulfilled by Warm Inboxes.</li>
          <li class="to-brand"><strong>The direct costs of your order are paid.</strong> That covers things like Google and Microsoft licences, domain registrations and the work of setting up and warming your inboxes.</li>
          <li class="to-green"><strong>Everything left goes to {a.name}.</strong> The foundation uses it for its charitable work in {a.address.city}.</li>
        </ol>
        <div class="notice">
          <p>To ask how {a.name} has used the funds it received, or to request its financial records, email <a href={`mailto:${a.email}`}>{a.email}</a>.</p>
        </div>
      </section>

      <section class="block" id="mission" aria-labelledby="mission-h">
        <h2 id="mission-h">{a.name}'s work</h2>
        <div class="prose">
          <p>{a.name}'s mission, programs and updates are published on its own website, <a href={`${a.url}/`} target="_blank" rel="noopener">{a.url.replace('https://', '')}</a>. That is the authoritative source for what the foundation does.</p>
        </div>
      </section>

      <section class="block" id="purchases" aria-labelledby="pur-h">
        <h2 id="pur-h">Buying from PreWarmed is not a donation</h2>
        <div class="prose">
          <p>When you order from PreWarmed you are paying a commercial price for a commercial service. Your payment is not a charitable gift, you will not receive a donation receipt, and it does not carry any tax benefit. The proceeds that reach {a.name} are given by PreWarmed, not by you.</p>
          <p>If you would like to donate to {a.name} yourself, contact the foundation through <a href={`${a.url}/`} target="_blank" rel="noopener">{a.url.replace('https://', '')}</a> or at <a href={`mailto:${a.email}`}>{a.email}</a>.</p>
        </div>
      </section>

      <section class="block" aria-labelledby="faq-h">
        <h2 id="faq-h">Common questions</h2>
        <div class="qa-scroll">
          <table class="qa">
            <tr><th scope="row">Who runs PreWarmed?</th><td>{site.entity}, the team behind Warm Inboxes and Upscale B2B. Orders are fulfilled by Warm Inboxes.</td></tr>
            <tr><th scope="row">How much goes to {a.name}?</th><td>All net proceeds: everything left after the direct costs of delivering the service.</td></tr>
            <tr><th scope="row">Is this {a.name}'s official website?</th><td>No. This is PreWarmed's website. {a.name}'s own website is <a href={`${a.url}/`} target="_blank" rel="noopener">{a.url.replace('https://', '')}</a>.</td></tr>
            <tr><th scope="row">Is my order tax-deductible?</th><td>No. Orders are purchases of a commercial service.</td></tr>
            <tr><th scope="row">Who handles refunds?</th><td>Warm Inboxes, under the <a href="/refund-policy/">refund policy</a>.</td></tr>
          </table>
        </div>
      </section>

      <section class="block" id="contact" aria-labelledby="contact-h">
        <h2 id="contact-h">Contact</h2>
        <div class="prose">
          <p>About {a.name}, its registration or its charitable work: <a href={`mailto:${a.email}`}>{a.email}</a>.</p>
          <p>About PreWarmed orders or services: the <a href="/contact/">PreWarmed contact page</a>, or <a href={`mailto:${site.correctionsEmail}`}>{site.correctionsEmail}</a>.</p>
        </div>
      </section>
    </div>

    <aside class="record" aria-labelledby="record-h">
      <h2 id="record-h">{a.name}</h2>
      <p class="sub">Organization details</p>
      <dl>
        <div class="row"><dt>Charity ID</dt><dd class="id">{a.charityId}</dd></div>
        <div class="row"><dt>Address</dt><dd>Kot Ghulam Muhammad Khan<br />372-E Gulburg Colony<br />{a.address.city} {a.address.postal}<br />Pakistan</dd></div>
        <div class="row"><dt>Official contact</dt><dd><a href={`mailto:${a.email}`}>{a.email}</a></dd></div>
        <div class="row"><dt>Relationship to PreWarmed</dt><dd>Receives all of PreWarmed's net proceeds</dd></div>
      </dl>
      <a class="go" href={`${a.url}/`} target="_blank" rel="noopener">Visit {a.url.replace('https://', '')}</a>
    </aside>
  </div>
</main>

<footer class="site">
  <div class="wrap cols">
    <div>
      <h3>{a.name}</h3>
      <p>Charity ID: {a.charityId}<br />{a.address.city}, Pakistan<br /><a href={`mailto:${a.email}`}>{a.email}</a><br /><a href={`${a.url}/`} target="_blank" rel="noopener">{a.url.replace('https://', '')}</a></p>
    </div>
    <nav aria-label="Footer">
      <h3>Company</h3>
      <ul>
        <li><a href="/about/">About</a></li>
        {!atRoot && <li><a href="/alpha-foundation/">{a.name}</a></li>}
        <li><a href="/how-it-works/">How it works</a></li>
        <li><a href="/pricing/">Pricing</a></li>
        <li><a href="/contact/">Contact</a></li>
        <li><a href="/privacy/">Privacy policy</a></li>
        <li><a href="/terms/">Terms</a></li>
        <li><a href="/refund-policy/">Refund policy</a></li>
      </ul>
    </nav>
  </div>
</footer>
<Consent />
</body>
</html>

<style is:global>
:root{
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px);
  padding-bottom:env(safe-area-inset-bottom,0px);
  --ink:#1B2733; --body:#3A4652; --muted:#66727E;
  --paper:#F6F7F8; --surface:#FFFFFF; --rule:#D9DEE3;
  --green:#1E5B47; --green-tint:#E7F0EC;
  --brand:#C24E10; --brand-bright:#FF6A1F;

  /* The consent banner is shared with the rest of the site, which is dark and
     token-driven. Rather than import that stylesheet and have it fight this
     page's typography, the handful of names it reads are mapped onto this
     page's palette. */
  --bg-elev:var(--surface); --border-strong:var(--rule);
  --text:var(--ink); --text-2:var(--body);
  --accent:var(--brand); --accent-hover:var(--brand-bright); --accent-ink:#FFFFFF;
  --wrap:68rem; --r-btn:4px;
  --font-display:"Public Sans",system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
}
@media (prefers-color-scheme:dark){
  :root:not([data-theme="light"]){
    --ink:#E8ECEF; --body:#C3CBD2; --muted:#93A0AB;
    --paper:#12181E; --surface:#1A222A; --rule:#2C3742;
    --green:#7CC4A8; --green-tint:#1B2E28; --brand:#FF8A4C;
  }
}
:root[data-theme="dark"]{
  --ink:#E8ECEF; --body:#C3CBD2; --muted:#93A0AB;
  --paper:#12181E; --surface:#1A222A; --rule:#2C3742;
  --green:#7CC4A8; --green-tint:#1B2E28; --brand:#FF8A4C;
}
*,*::before,*::after{box-sizing:inherit}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;background:var(--paper);color:var(--body);
  font:400 1.0625rem/1.65 "Public Sans",system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}
h1,h2,h3{font-family:"Newsreader",Georgia,"Times New Roman",serif;color:var(--ink);font-weight:500;line-height:1.2;margin:0}
h1{font-size:clamp(2.1rem,5vw,3.1rem);letter-spacing:-.01em;max-width:24ch}
h2{font-size:clamp(1.45rem,3vw,1.85rem);margin-bottom:.75rem}
h3{font-size:1.15rem;font-weight:600;margin-bottom:.35rem}
p{margin:0 0 1rem}
a{color:var(--green);text-underline-offset:.18em}
a:focus-visible{outline:3px solid var(--green);outline-offset:3px;border-radius:2px}
.skip{position:absolute;left:-999px}
.skip:focus{left:1rem;top:1rem;background:var(--surface);padding:.5rem 1rem;z-index:10}
.wrap{max-width:68rem;margin:0 auto;padding:0 1.25rem}
.prose{max-width:40rem}

header.site{border-bottom:1px solid var(--rule);background:var(--surface)}
header.site .wrap{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding-top:.9rem;padding-bottom:.9rem;flex-wrap:wrap}
.crumb{font-size:.9rem;color:var(--muted)}
.crumb a,.crumb b{color:var(--brand);font-weight:600;text-decoration:none}
nav.local{display:flex;gap:1.1rem;flex-wrap:wrap;font-size:.92rem}
nav.local a{color:var(--body);text-decoration:none}
nav.local a:hover{color:var(--green);text-decoration:underline}

.intro{padding:3.5rem 0 2.5rem}
.intro .lede{font-size:1.2rem;max-width:38rem;margin-top:1rem}
.layout{display:grid;grid-template-columns:minmax(0,1fr) 21rem;gap:3rem;align-items:start;padding-bottom:4rem}
/* minmax(0,1fr), not 1fr: a grid item sizes to its content by default, so
   the FAQ table's own min-width pushed the whole page sideways on a phone
   instead of scrolling inside its own box. */
@media (max-width:860px){.layout{grid-template-columns:minmax(0,1fr);gap:2rem}.layout>div{min-width:0}.record{order:-1}}

.record{background:var(--surface);border:1px solid var(--rule);border-top:4px solid var(--green);position:sticky;top:calc(env(safe-area-inset-top,0px) + 1rem)}
@media (max-width:860px){.record{position:static}}
.record h2{font-size:1.25rem;padding:1.25rem 1.25rem .25rem;margin:0}
.record p.sub{padding:0 1.25rem;color:var(--muted);font-size:.9rem;margin-bottom:.75rem}
.record dl{margin:0}
.record .row{padding:.8rem 1.25rem;border-top:1px solid var(--rule)}
.record dt{font-size:.82rem;color:var(--muted);margin-bottom:.15rem}
.record dd{margin:0;color:var(--ink);font-weight:500;overflow-wrap:anywhere}
.record dd.id{font-family:"Newsreader",Georgia,serif;font-size:1.5rem;letter-spacing:.02em}
.record .go{display:block;padding:1rem 1.25rem;border-top:1px solid var(--rule);background:var(--green);color:#fff;text-decoration:none;font-weight:600}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]) .record .go{color:#0E1A15}}
:root[data-theme="dark"] .record .go{color:#0E1A15}

section.block{padding:2rem 0;border-top:1px solid var(--rule)}
section.block:first-child{border-top:0;padding-top:0}

/* The money path is a real sequence, so it is numbered. */
ol.flow{list-style:none;margin:1.5rem 0 0;padding:0;counter-reset:step;display:grid;gap:0}
ol.flow li{counter-increment:step;position:relative;padding:0 0 1.5rem 3.25rem;border-left:2px solid var(--rule);margin-left:1rem}
ol.flow li:last-child{border-left-color:transparent;padding-bottom:0}
ol.flow li::before{content:counter(step);position:absolute;left:-1.05rem;top:-.1rem;width:2rem;height:2rem;border-radius:50%;
  display:grid;place-items:center;font:600 .95rem "Public Sans",sans-serif;background:var(--surface);border:2px solid var(--rule);color:var(--ink)}
ol.flow li.to-brand::before{border-color:var(--brand);color:var(--brand)}
ol.flow li.to-green::before{border-color:var(--green);background:var(--green);color:var(--surface)}
ol.flow strong{color:var(--ink)}

.split{display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-top:1.25rem}
@media (max-width:600px){.split{grid-template-columns:1fr}}
.entity{background:var(--surface);border:1px solid var(--rule);padding:1.1rem 1.2rem}
.entity.nonprofit{border-left:4px solid var(--green)}
.entity.commercial{border-left:4px solid var(--brand-bright)}
.entity p{margin:.4rem 0 0;font-size:.97rem}

.notice{background:var(--green-tint);padding:1rem 1.2rem;margin-top:1.25rem;color:var(--ink)}
.notice p:last-child{margin:0}

.qa-scroll{overflow-x:auto}
table.qa{width:100%;border-collapse:collapse;margin-top:.5rem;min-width:30rem}
table.qa th,table.qa td{text-align:left;vertical-align:top;padding:.75rem .5rem;border-top:1px solid var(--rule)}
table.qa th{width:38%;color:var(--ink);font-weight:600}

footer.site{background:var(--surface);border-top:1px solid var(--rule);padding:2rem 0;font-size:.92rem}
footer.site .cols{display:grid;grid-template-columns:1fr 1fr;gap:2rem}
@media (max-width:760px){footer.site .cols{grid-template-columns:1fr}}
footer.site ul{list-style:none;margin:0;padding:0;display:grid;gap:.35rem}
footer.site h3{font-family:"Public Sans",sans-serif;font-size:.95rem;margin-bottom:.5rem}

/* The consent banner's own classes, which live in the site stylesheet this
   page does not load. */
.btn{display:inline-flex;align-items:center;gap:8px;justify-content:center;
  font-family:var(--font-display);font-size:15px;font-weight:600;
  padding:12px 20px;border-radius:var(--r-btn);border:1px solid transparent;cursor:pointer}
.btn-primary{background:var(--accent);color:var(--accent-ink)}
.btn-ghost{border-color:var(--border-strong);color:var(--text);background:transparent}
</style>

---
/**
 * The buying moment, as a choice rather than a yes/no.
 *
 * Two equal orange buttons, prewarmed and fresh, each with the one-line
 * reason to pick it, and a "Help me choose" WhatsApp button beside them. The
 * question on the page is never "do I buy?", only "which do I buy?", and
 * both answers are sold by the same team in the same app.
 *
 *   platform  'google' | 'azure' | 'microsoft' | null  names the product in
 *             the labels; null keeps them generic ("inboxes").
 *   lead      'prewarmed' | 'fresh'  which option sits first. Product pages
 *             lead with their own family.
 *   page, placement  tracking. Each button adds -prewarmed or -fresh to
 *             utm_content, so GA4 shows which way people chose.
 *   help      false drops the WhatsApp button where one is already next to it.
 *   align     'center' for centred closing sections.
 */
import { order } from '../data/site.js';
import pricing from '../data/pricing.json';
import WhatsApp from './WhatsApp.astro';

const { platform = null, lead = 'prewarmed', page = 'site', placement = 'body', help = true, align = 'start', full = false } = Astro.props;

const noun = {
  google: ['prewarmed Google inboxes', 'fresh Google inboxes'],
  azure: ['a prewarmed Azure tenant', 'a fresh Azure tenant'],
  microsoft: ['prewarmed Microsoft 365', 'fresh Microsoft 365'],
}[platform] ?? ['prewarmed inboxes', 'fresh inboxes'];

const freshSub = platform === 'azure'
  ? `Warm up first · $${pricing.products['azure-fresh'].perTenant.monthly} on any billing cycle`
  : 'Warm up first · up to 2X less';

const options = {
  prewarmed: { key: 'prewarmed', title: `Get ${noun[0]}`, sub: 'Send the day they arrive · FREE domain' },
  fresh: { key: 'fresh', title: `Get ${noun[1]}`, sub: freshSub },
};
const list = lead === 'fresh' ? [options.fresh, options.prewarmed] : [options.prewarmed, options.fresh];
---
<div class={`bc${align === 'center' ? ' bc-center' : ''}${full ? ' bc-full' : ''}`}>
  <div class="bc-pair">
    {list.map((o) => (
      <a class={`btn btn-primary btn-lg bc-opt bc-${o.key}`} href={order({ page, placement: `${placement}-${o.key}` })} target="_blank" rel="noopener">
        <span class="bc-t">{o.title}</span>
        <span class="bc-s">{o.sub}</span>
      </a>
    ))}
  </div>
  {help && <WhatsApp label="Help me choose" />}
</div>

<style>
  .bc { display: flex; flex-wrap: wrap; gap: 12px; align-items: stretch; }
  .bc-center { justify-content: center; }
  /* Two lines inside one button: what you get, and why you would pick it. */
  .bc-opt { flex-direction: column; align-items: flex-start; justify-content: center; gap: 3px; text-align: left; min-width: 250px; padding: 12px 22px; }
  .bc-t { font-size: 16.5px; line-height: 1.25; }
  .bc-s { font-size: 12.5px; font-weight: 500; line-height: 1.3; opacity: .82; }
  /* Same height as the two-line choice buttons, even when it wraps onto its
     own line in a narrow column or on a phone. */
  .bc :global(.wa) { align-self: stretch; margin-top: 0; min-height: 66px; }
  /* The two options as exact equals: an inline grid sizes both columns to
     the wider label, so neither button looks like the lesser choice. */
  .bc-pair { display: inline-grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .bc-center .bc-pair { justify-self: center; }
  /* Stacked: in a narrow panel, or always on a phone. */
  .bc-full { flex-direction: column; }
  .bc-full .bc-pair { display: grid; grid-template-columns: 1fr; }
  .bc-full .bc-opt, .bc-full :global(.wa) { width: 100%; min-width: 0; }
  @media (max-width: 620px) {
    .bc { flex-direction: column; }
    .bc-pair { display: grid; grid-template-columns: 1fr; }
    .bc-opt, .bc :global(.wa) { width: 100%; min-width: 0; }
  }
</style>

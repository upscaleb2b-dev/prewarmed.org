---
/**
 * The operator's own numbers, from warminboxes.com/offer.
 *
 * The point of the row is that these are the fulfiller's own campaigns, not
 * an industry benchmark — a provider that sends at this volume on the same
 * infrastructure is a different claim from one quoting someone else's study.
 */
import { operator, campaigns, certifications } from '../data/proof.js';
import { wi } from '../data/site.js';
const { page = 'site', showCampaigns = true } = Astro.props;
---
<section class="pf">
  <div class="wrap">
    <div class="pf-top">
      <div><b class="mono">{operator.monthlySends}</b><span>cold emails sent a month on this infrastructure</span></div>
      <div><b class="mono">{operator.replyRate}</b><span>reply rate across those campaigns</span></div>
      <div><b class="mono">{operator.teamsServed}</b><span>teams running on it, including {operator.namedTeams.slice(0, 3).join(', ')}</span></div>
    </div>

    {showCampaigns && (
      <div class="pf-cmp">
        <p class="pf-h">Individual campaigns, as published by the operator</p>
        <div class="cgrid">
          {campaigns.map((c) => (
            <div class="c">
              <p class="mono big">{c.pipeline}</p>
              <p class="cl">pipeline from <b>{c.sent}</b> sent at <b>{c.reply}</b> reply</p>
            </div>
          ))}
        </div>
      </div>
    )}

    <p class="pf-cert">
      {certifications.map((c, i) => <span>{i > 0 && <i aria-hidden="true"> · </i>}{c.label}</span>)}
    </p>
    <p class="pf-note">
      Figures published by <a href={wi('/offer', { page, placement: 'proof' })} target="_blank" rel="noopener">Warm Inboxes <span class="ext" aria-hidden="true">↗</span></a>, who fulfil orders placed here. They are that team's own campaign results, not an industry average, and not a prediction of yours.
    </p>
  </div>
</section>

<style>
  .pf { padding-block: 52px; background: var(--bg-elev); border-block: 1px solid var(--border); }
  .pf-top { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  @media (max-width: 760px) { .pf-top { grid-template-columns: 1fr; gap: 20px; } }
  .pf-top b { display: block; font-size: 30px; font-weight: 500; color: var(--accent); letter-spacing: -.02em; }
  .pf-top span { display: block; margin-top: 4px; font-size: 14px; color: var(--text-2); line-height: 1.45; }
  .pf-cmp { margin-top: 34px; }
  .pf-h { font-size: 12px; letter-spacing: .09em; text-transform: uppercase; color: var(--text-muted); margin: 0 0 12px; font-weight: 600; }
  .cgrid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
  @media (max-width: 820px) { .cgrid { grid-template-columns: repeat(2, 1fr); } }
  .c { background: var(--bg); border: 1px solid var(--border); border-radius: 10px; padding: 15px 17px; }
  .c .big { font-size: 22px; font-weight: 500; color: var(--text); margin: 0 0 5px; }
  .c .cl { font-size: 12.5px; color: var(--text-muted); margin: 0; line-height: 1.45; }
  .c .cl b { color: var(--text-2); font-weight: 500; }
  .pf-cert { margin: 26px 0 0; font-size: 14px; color: var(--text-2); }
  .pf-note { margin: 10px 0 0; font-size: 13px; color: var(--text-muted); max-width: 72ch; line-height: 1.5; }
</style>

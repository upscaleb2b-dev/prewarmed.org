---
/**
 * The free Deliverability Agent: the Warm Inboxes MCP server, added to the
 * AI the reader already uses. Same pitch, address and "works in" picker as
 * warminboxes.com/deliverability-tools, from src/data/ai-clients.json.
 *
 * Each assistant either opens its own add-server screen, installs the server
 * through a deep link (Cursor, Copilot), or copies the line to paste. Copy
 * buttons say what was copied and where it goes, because a silent copy looks
 * like a broken button.
 */
import ai from '../data/ai-clients.json';
const {
  tag = 'Free deliverability agent',
  heading = 'Turn your own AI into a deliverability consultant',
  lead = 'Add one address to Claude, ChatGPT, Cursor or any MCP client. Describe what is wrong with your cold email in your own words: it runs the checks itself, reads the results and tells you the fix, cheapest first. No account, no API key.',
  guide = true,
  id = 'agent',
} = Astro.props;
---
<section class="agent" id={id} aria-labelledby={`${id}-h`}>
  {tag && <p class="tag">{tag}</p>}
  <h2 id={`${id}-h`}>{heading}</h2>
  {lead && <p class="lead">{lead}</p>}

  <div class="url">
    <code class="mono">{ai.mcp}</code>
    <button type="button" class="cp" data-copy={ai.mcp} data-what="the address">Copy</button>
  </div>

  <p class="works">Works in</p>
  <ul class="clients">
    {ai.clients.map((c) => (
      <li>
        {c.href
          ? <a class="client" href={c.href} title={c.title} aria-label={c.title} data-client={c.name} {...(c.newTab ? { target: '_blank', rel: 'noopener' } : {})}><span class="ico" set:html={c.svg} /><span>{c.name}</span></a>
          : <button type="button" class="client" title={c.title} aria-label={c.title} data-client={c.name} data-copy={c.copy} data-what={`the ${c.name} setup line`}><span class="ico" set:html={c.svg} /><span>{c.name}</span></button>}
      </li>
    ))}
  </ul>
  <p class="how" aria-live="polite" data-default="Click one: it opens the assistant's own add-server screen, installs the server, or copies the line to paste.">Click one: it opens the assistant's own add-server screen, installs the server, or copies the line to paste.</p>
  {guide && <p class="guide"><a href={ai.guide}>What it does, what to ask it, and how it works →</a></p>}
</section>

<script is:inline>
(() => {
  if (window.__pwAgent) return;
  window.__pwAgent = true;
  document.addEventListener('click', async (e) => {
    const el = e.target.closest('.agent [data-copy], .agent a.client');
    if (!el) return;
    const sec = el.closest('.agent');
    const name = el.dataset.client || 'address';
    if (window.gtag) window.gtag('event', 'agent_connect', { client: name, pw_from: location.pathname });
    if (!el.dataset.copy) return;
    const how = sec.querySelector('.how');
    try {
      await navigator.clipboard.writeText(el.dataset.copy);
      how.textContent = 'Copied ' + el.dataset.what + ': ' + el.dataset.copy;
    } catch {
      how.textContent = 'Copy this: ' + el.dataset.copy;
    }
    clearTimeout(sec.__t);
    sec.__t = setTimeout(() => { how.textContent = how.dataset.default; }, 6000);
  });
})();
</script>

<style>
  /* Clear the sticky support bar and nav when a button jumps to #agent. */
  .agent {
    scroll-margin-top: 160px;
    text-align: center; padding: 34px 28px 28px; margin: 0 auto;
    border: 1px solid color-mix(in srgb, var(--accent) 45%, transparent);
    border-radius: var(--r-card);
    background: radial-gradient(120% 90% at 50% 0%, color-mix(in srgb, var(--accent) 14%, var(--bg-elev)), var(--bg-elev) 70%);
  }
  .tag { display: inline-block; margin: 0 0 14px; font-size: 11.5px; letter-spacing: .09em; text-transform: uppercase; color: var(--accent); font-weight: 600; border: 1px solid color-mix(in srgb, var(--accent) 40%, transparent); background: var(--accent-soft); border-radius: 999px; padding: 5px 12px; }
  .agent h2 { margin: 0 auto 12px; max-width: 22ch; }
  .lead { margin: 0 auto 22px; max-width: 64ch; color: var(--text-2); }
  .url { display: flex; align-items: center; justify-content: center; gap: 10px; max-width: 560px; margin: 0 auto; padding: 10px 10px 10px 18px; border: 1px solid var(--border-strong); border-radius: 12px; background: var(--bg); }
  .url code { flex: 1; color: var(--accent); font-size: 16px; text-align: left; overflow-wrap: anywhere; }
  .cp { flex: none; border: 1px solid var(--border-strong); background: transparent; color: var(--text); border-radius: 8px; padding: 8px 14px; font-weight: 600; cursor: pointer; min-height: 40px; }
  .cp:hover { border-color: var(--accent); color: var(--accent); }
  .works { margin: 28px 0 12px; font-size: 11.5px; letter-spacing: .12em; text-transform: uppercase; color: var(--text-muted); font-weight: 600; }
  .clients { list-style: none; padding: 0; margin: 0 auto; max-width: 820px; display: flex; flex-wrap: wrap; justify-content: center; gap: 6px; }
  .client { display: flex; flex-direction: column; align-items: center; gap: 8px; width: 92px; padding: 12px 6px; border: 1px solid transparent; border-radius: 12px; background: none; color: var(--text-2); font: inherit; font-size: 13px; cursor: pointer; text-decoration: none; }
  .client:hover, .client:focus-visible { border-color: var(--border-strong); background: var(--bg); color: var(--text); text-decoration: none; }
  .ico { display: grid; place-items: center; width: 30px; height: 30px; color: var(--text); }
  .ico :global(svg) { width: 30px; height: 30px; }
  .how { margin: 14px auto 0; max-width: 64ch; font-size: 13.5px; color: var(--text-muted); overflow-wrap: anywhere; }
  .guide { margin: 14px 0 0; font-size: 14.5px; }
  @media (max-width: 560px) {
    .agent { padding: 26px 16px 22px; }
    .url { padding-left: 12px; }
    .url code { font-size: 13px; white-space: nowrap; overflow-wrap: normal; }
    .cp { padding: 8px 12px; }
    .clients { gap: 4px 0; }
    .clients li { flex: 0 0 25%; display: flex; justify-content: center; }
    .client { width: 100%; padding: 10px 2px; }
  }
</style>
